<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Neutral charcoal surfaces and blue selection, inspired by Visual Studio. -->
  <SolidColorBrush x:Key="WindowBrush" Color="#1E1E1E" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#252526" />
  <SolidColorBrush x:Key="TextBrush" Color="#D4D4D4" />
  <SolidColorBrush x:Key="MutedBrush" Color="#B1B1BA" />
  <SolidColorBrush x:Key="LineBrush" Color="#454549" />
  <SolidColorBrush x:Key="AccentBrush" Color="#007ACC" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="RowBrush" Color="#1E1E1E" />
  <SolidColorBrush x:Key="AlternateRowBrush" Color="#2A2A2D" />
  <SolidColorBrush x:Key="RowHoverBrush" Color="#333B48" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#264F78" />
  <SolidColorBrush x:Key="SelectionTextBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="HeaderBrush" Color="#333337" />
  <SolidColorBrush x:Key="HeaderTextBrush" Color="#E0E0E0" />
  <SolidColorBrush x:Key="GridLineBrush" Color="#39393D" />
  <SolidColorBrush x:Key="StatusTextBrush" Color="#F0F0F0" />
  <SolidColorBrush x:Key="StatusQueuedBrush" Color="#3C3C42" />
  <SolidColorBrush x:Key="StatusRunningBrush" Color="#264F78" />
  <SolidColorBrush x:Key="StatusCompletedBrush" Color="#254A38" />
  <SolidColorBrush x:Key="StatusFailedBrush" Color="#633439" />
  <SolidColorBrush x:Key="StatusCancelledBrush" Color="#594624" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#FF9B92" />
</ResourceDictionary>
