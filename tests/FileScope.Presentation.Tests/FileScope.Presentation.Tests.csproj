<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FileScope.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/FileScope.Core/FileScope.Core.csproj" />
    <ProjectReference Include="../../src/FileScope.Shared/FileScope.Shared.csproj" />
    <!-- Exercise the existing UI-independent sources on every supported host. -->
    <Compile Include="../../src/FileScope.App/Presentation/*.cs" Link="App/Presentation/%(Filename)%(Extension)" />
    <Compile Include="../../src/FileScope.App/Services/PreferencesStore.cs" Link="App/Services/PreferencesStore.cs" />
    <Compile Include="../../src/FileScope.App/ViewModels/Options.cs" Link="App/ViewModels/Options.cs" />
    <Compile Include="../../src/FileScope.App/ViewModels/ColumnOption.cs" Link="App/ViewModels/ColumnOption.cs" />
    <Compile Include="../../src/FileScope.App/ViewModels/SignatureOption.cs" Link="App/ViewModels/SignatureOption.cs" />
    <Compile Include="../../src/FileScope.App/ViewModels/OptionsViewModel.cs" Link="App/ViewModels/OptionsViewModel.cs" />
    <Compile Include="../../src/FileScope.App/ViewModels/FileRowViewModel.cs" Link="App/ViewModels/FileRowViewModel.cs" />
    <EmbeddedResource Include="../../src/FileScope.App/Resources/Strings*.resx" Link="Resources/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Source assets are embedded only in the test assembly. Checks work from
         any working directory and do not need WPF or an adjacent checkout. -->
    <EmbeddedResource Include="../../src/FileScope.App/**/*.xaml"
                      Exclude="../../src/FileScope.App/bin/**;../../src/FileScope.App/obj/**"
                      LogicalName="Source.Xaml.%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../src/FileScope.Shared/Wpf/*.xaml;../../src/FileScope.Shared/Styles/**/*.xaml"
                      LogicalName="Source.Xaml.Shared.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../src/DuplicateFinder.App/**/*.xaml"
                      Exclude="../../src/DuplicateFinder.App/bin/**;../../src/DuplicateFinder.App/obj/**"
                      LogicalName="DuplicateFinder.Xaml.%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../src/FileScope.App/FileScope.App.csproj" LogicalName="Source.AppProject.xml" />
    <EmbeddedResource Include="../../src/FileScope.App/Resources/FileScopeSplash.png" LogicalName="Source.Splash.png" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="FileScope.Shared" />
  </ItemGroup>
</Project>
