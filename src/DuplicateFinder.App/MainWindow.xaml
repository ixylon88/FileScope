<Window x:Class="DuplicateFinder.App.MainWindow" x:Name="WindowRoot" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DuplicateFinder.App"
        xmlns:shared="clr-namespace:FileScope.Shared;assembly=FileScope.Shared"
        Icon="Resources/DuplicateFinder.ico" Title="DuplicateFinder" Width="1160" Height="770" MinWidth="700" MinHeight="460"
        Style="{StaticResource AppWindowStyle}" PreviewKeyDown="WindowKeyDown">
  <Window.Resources>
    <shared:FileRowContextMenu x:Key="FileMenu">
      <shared:FileRowContextMenu.LeadingAction>
        <MenuItem Header="{loc:Loc Recycle}" Command="{Binding RecycleCommand}" />
      </shared:FileRowContextMenu.LeadingAction>
    </shared:FileRowContextMenu>
    <!-- Fluent's SystemAccentColor is itself a dynamic reference. Ask Windows for the Color directly. -->
    <SolidColorBrush x:Key="MarkedRowBackground" Color="{DynamicResource {x:Static SystemColors.AccentColorKey}}" Opacity="0.24" />
    <Style x:Key="FileCells" TargetType="DataGridCellsPanel">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Marked}" Value="True">
          <Setter Property="Background" Value="{StaticResource MarkedRowBackground}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="BandDivider" TargetType="Border">
      <Setter Property="Width" Value="1" />
      <Setter Property="Margin" Value="6,0,14,6" />
      <Setter Property="Background" Value="{DynamicResource LineBrush}" />
    </Style>
  </Window.Resources>
  <Grid Margin="18,14,18,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border x:Name="MenuFrame" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,10">
      <Expander x:Name="MenuExpander" Header="{loc:Loc MenuTitle}" IsExpanded="True" Padding="14,8">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="ScanButton" Command="{Binding ScanCommand, ElementName=WindowRoot}" Content="{loc:Loc Scan}" Style="{StaticResource BandButton}" />
              <Button x:Name="CancelButton" Command="{Binding CancelCommand, ElementName=WindowRoot}" Content="{loc:Loc Cancel}" Style="{StaticResource BandButton}" />
              <Button x:Name="IssuesButton" Command="{Binding IssuesCommand, ElementName=WindowRoot}" Content="{loc:Loc Issues}" Style="{StaticResource BandButton}" />
            </StackPanel>
            <Border Style="{StaticResource BandDivider}" />
            <StackPanel Orientation="Horizontal">
              <Button x:Name="CleanButton" Command="{Binding CleanCommand, ElementName=WindowRoot}" Content="{loc:Loc Clean}" Style="{StaticResource BandButton}" />
              <Button x:Name="RecycleButton" Command="{Binding RecycleCommand, ElementName=WindowRoot}" Content="{loc:Loc Recycle}" Style="{StaticResource BandButton}" />
            </StackPanel>
            <Border Style="{StaticResource BandDivider}" />
            <StackPanel Orientation="Horizontal">
              <Button x:Name="OptionsButton" Command="{Binding OptionsCommand, ElementName=WindowRoot}" Style="{StaticResource BandButton}" AutomationProperties.Name="{loc:Loc Options}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBlock Text="{loc:Loc Options}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="ShortcutsButton" Command="ApplicationCommands.Help" Style="{StaticResource BandButton}"
                      ToolTip="{loc:Loc ShortcutsTip}" AutomationProperties.Name="{loc:Loc ShortcutsTitle}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE765;" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBlock Text="{loc:Loc ShortcutsButton}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="AboutButton" Command="{Binding AboutCommand, ElementName=WindowRoot}" Style="{StaticResource BandButton}" AutomationProperties.Name="{loc:Loc AboutButton}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBlock Text="{loc:Loc AboutButton}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Expander>
    </Border>

    <Grid x:Name="FiltersPanel" Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" /><ColumnDefinition Width="1*" MaxWidth="174" />
        <ColumnDefinition Width="1.5*" MaxWidth="280" /><ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="{loc:Loc Filter}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="FilterBox" MinHeight="34" Padding="9,5" TextChanged="FilterChanged"
                 ToolTip="{loc:Loc FilterHint}" AutomationProperties.Name="{loc:Loc Filter}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,12,0">
        <TextBlock Text="{loc:Loc ResultKind}" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="KindBox" MinHeight="34" SelectionChanged="FilterChanged" AutomationProperties.Name="{loc:Loc ResultKind}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Margin="0,0,12,0">
        <TextBlock Text="{loc:Loc SignatureFilterLabel}" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="SignatureBox" MinHeight="34" DisplayMemberPath="Label" SelectedValuePath="Value"
                  SelectionChanged="FilterChanged" AutomationProperties.Name="{loc:Loc SignatureFilterLabel}" />
      </StackPanel>
      <Button x:Name="ResetFiltersButton" Command="{Binding ResetFiltersCommand, ElementName=WindowRoot}" Grid.Column="3" Content="{loc:Loc ResetFilters}"
              VerticalAlignment="Bottom" Padding="12,7" MinHeight="34" />
    </Grid>

    <Border x:Name="ResultsFrame" Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
      <DataGrid x:Name="Files" Style="{StaticResource ResultsGridStyle}" BorderThickness="0" GridLinesVisibility="Horizontal" ItemsSource="{Binding View}" AutoGenerateColumns="False"
                CanUserSortColumns="False" IsSynchronizedWithCurrentItem="False" SelectionChanged="FileSelectionChanged"
                HeadersVisibility="Column" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling"
                ScrollViewer.CanContentScroll="True">
        <DataGrid.GroupStyle>
          <GroupStyle>
            <GroupStyle.Panel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></GroupStyle.Panel>
            <GroupStyle.ContainerStyle>
              <Style TargetType="GroupItem">
                <Setter Property="Template"><Setter.Value>
                  <ControlTemplate TargetType="GroupItem">
                    <Expander IsExpanded="False" AutomationProperties.Name="{Binding Name}">
                      <Expander.Header><StackPanel Orientation="Horizontal">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}"/>
                        <TextBlock Margin="10,0" Foreground="{DynamicResource MutedBrush}" Text="{Binding ItemCount}"/>
                      </StackPanel></Expander.Header>
                      <ItemsPresenter/>
                    </Expander>
                  </ControlTemplate>
                </Setter.Value></Setter>
              </Style>
            </GroupStyle.ContainerStyle>
          </GroupStyle>
        </DataGrid.GroupStyle>
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="RowClick" />
            <EventSetter Event="ContextMenuOpening" Handler="FileMenuOpening" />
            <Setter Property="ContextMenu" Value="{StaticResource FileMenu}" />
            <!-- The Fluent row border paints its own transparent background. The cells panel draws the mark behind the cells. -->
            <Setter Property="ItemsPanel">
              <Setter.Value>
                <ItemsPanelTemplate>
                  <DataGridCellsPanel Style="{StaticResource FileCells}" />
                </ItemsPanelTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="{loc:Loc Name}" Width="232" ClipboardContentBinding="{Binding File.Name, Mode=OneWay}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <DockPanel Margin="9,0,0,0">
                  <CheckBox MinWidth="32" VerticalAlignment="Center" IsChecked="{Binding Marked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding DataContext.CanMark, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                            ToolTip="{loc:Loc Mark}" AutomationProperties.Name="{loc:Loc Mark}" />
                  <TextBlock Text="{Binding File.Name, Mode=OneWay}" Style="{StaticResource GridText}" />
                </DockPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="{loc:Loc Priority}" Binding="{Binding File.Root.Priority, Mode=OneWay}" Width="75" ElementStyle="{StaticResource GridText}"/>
          <DataGridTextColumn Header="{loc:Loc Variant}" Binding="{Binding File.Variant, Mode=OneWay}" Width="65" ElementStyle="{StaticResource GridText}"/>
          <DataGridTextColumn Header="{loc:Loc Bytes}" Binding="{Binding File.Size, Mode=OneWay}" Width="92" ElementStyle="{StaticResource GridText}"/>
          <DataGridTextColumn Header="{loc:Loc Modified}" Binding="{Binding ModifiedText, Mode=OneWay}" Width="Auto" MinWidth="145"
                              ElementStyle="{StaticResource GridText}"/>
          <DataGridTextColumn Header="{loc:Loc Streams}" Binding="{Binding Streams, Mode=OneWay}" Width="240" ElementStyle="{StaticResource GridText}"/>
          <shared:CellBoundTemplateColumn Header="{loc:Loc SignatureFilterLabel}" Width="Auto" MinWidth="160" MaxWidth="360" ClipboardContentBinding="{Binding Signature}">
            <shared:CellBoundTemplateColumn.CellTemplate>
              <DataTemplate><shared:StatusBadge Text="{Binding Signature}" Tone="{Binding SignatureTone}" /></DataTemplate>
            </shared:CellBoundTemplateColumn.CellTemplate>
          </shared:CellBoundTemplateColumn>
          <DataGridTextColumn Header="{loc:Loc Column_Catalog}" Binding="{Binding Catalog, Mode=OneWay}" Width="160" ElementStyle="{StaticResource GridText}"/>
          <DataGridTextColumn Header="{loc:Loc Publisher}" Binding="{Binding File.Embedded.Certificate.Publisher, Mode=OneWay}" Width="155" ElementStyle="{StaticResource GridText}"/>
          <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256, Mode=OneWay}" Width="172" ElementStyle="{StaticResource HashText}"/>
          <DataGridTextColumn Header="{loc:Loc Diagnostics}" Binding="{Binding Diagnostic, Mode=OneWay}" Width="180" ElementStyle="{StaticResource GridText}"/>
          <DataGridTextColumn x:Name="PathColumn" Header="{loc:Loc Path}" Binding="{Binding File.Path, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource GridText}"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Expander x:Name="DetailsExpander" Grid.Row="3" Margin="0,8,0,0" IsExpanded="False" HorizontalContentAlignment="Stretch">
      <Expander.Style>
        <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
          <Setter Property="DataContext" Value="{x:Null}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedItems.Count, ElementName=Files}" Value="1">
              <Setter Property="DataContext" Value="{Binding SelectedItem, ElementName=Files}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Expander.Style>
      <Expander.Header>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock Text="{loc:Loc Details}" VerticalAlignment="Center" />
          <TextBlock x:Name="DetailsPath" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="{Binding File.Path, Mode=OneWay, TargetNullValue='', FallbackValue=''}"
                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Grid>
      </Expander.Header>
      <TextBox x:Name="DetailsBox" Text="{Binding Details, Mode=OneWay, TargetNullValue='', FallbackValue=''}"
               IsReadOnly="True" TextWrapping="NoWrap" MinHeight="90" MaxHeight="160" Padding="12"
               FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="12" AutomationProperties.Name="{loc:Loc Details}"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
    </Expander>
    <DockPanel Grid.Row="4" Margin="0,9,0,0">
      <ProgressBar x:Name="Meter" DockPanel.Dock="Right" Width="115" Height="8" Margin="12,0,0,0"/>
      <TextBlock x:Name="Status" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
    </DockPanel>
    <TextBlock x:Name="FileActionErrorText" Grid.Row="5" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
               Visibility="Collapsed" TextWrapping="Wrap" Margin="0,6,0,0" />
  </Grid>
</Window>
