<Window x:Class="DuplicateFinder.App.ShortcutsWindow" x:Name="WindowRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DuplicateFinder.App"
        Title="{loc:Loc ShortcutsTitle}" Width="660" Height="560" MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Style="{StaticResource AppWindowStyle}">
  <Window.Resources>
    <Style TargetType="HeaderedContentControl">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="HeaderedContentControl">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="ShortcutKeys" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource ShortcutKeyCap}">
                <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource ShortcutKeys}" />
              </Border>
              <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" Style="{StaticResource ShortcutDescription}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
      <Border Width="44" Height="44" CornerRadius="10" Margin="0,0,14,0" Background="{DynamicResource SystemFillColorAttentionBrush}">
        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE765;" FontSize="23" VerticalAlignment="Center" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextOnAccentFillColorSelectedTextBrush}" />
      </Border>
      <TextBlock Text="{loc:Loc ShortcutsTitle}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
      <StackPanel Grid.IsSharedSizeScope="True">
        <TextBlock Text="{loc:Loc ShortcutActions}" Style="{StaticResource GroupHeading}" />
        <HeaderedContentControl Header="F5" Content="{loc:Loc KeyScan}" />
        <HeaderedContentControl Header="{loc:Loc ShortcutCancelKeys}" Content="{loc:Loc ShortcutCancelAction}" />
        <HeaderedContentControl Header="{loc:Loc ShortcutHelpKeys}" Content="{loc:Loc KeyHelp}" />
        <TextBlock Text="{loc:Loc ShortcutResults}" Style="{StaticResource GroupHeading}" Margin="0,12,0,8" />
        <HeaderedContentControl x:Name="FilterShortcut" Header="{loc:Loc KeysFilter}" Content="{loc:Loc KeyFilter}" />
        <HeaderedContentControl Header="{loc:Loc KeysMark}" Content="{loc:Loc KeyMark}" />
        <HeaderedContentControl Header="{loc:Loc ShortcutCopyKeys}" Content="{loc:Loc KeyCopy}" />
      </StackPanel>
    </ScrollViewer>

    <Button Grid.Row="2" Content="{loc:Loc Close}" IsDefault="True" IsCancel="True" Command="{Binding CloseCommand, ElementName=WindowRoot}"
            HorizontalAlignment="Right" MinWidth="100" Padding="16,8" Margin="0,16,0,0" />
  </Grid>
</Window>
