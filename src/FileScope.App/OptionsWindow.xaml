<Window x:Class="FileScope.App.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FileScope.App.Localization"
        Title="{loc:Loc OptionsTitle}" Width="730" Height="740" MinWidth="640" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Style="{StaticResource AppWindowStyle}" Language="{Binding UiLanguage, Mode=OneWay, ConverterCulture=en-US}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="{loc:Loc OptionsTitle}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18" />
    <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right">
        <TextBlock Text="{loc:Loc Group_Theme}" Style="{StaticResource FieldLabel}" Margin="0,10,0,5" />  
        <ComboBox x:Name="ThemeSelector" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" DisplayMemberPath="Label"
                  MinHeight="34" MinWidth="100" AutomationProperties.Name="{loc:Loc Group_Theme}" />
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="1" Margin="16,0,0,0">
        <TextBlock Text="{loc:Loc Group_Language}" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="NativeName"
                  MinHeight="34" AutomationProperties.Name="{loc:Loc Group_Language}" />
      </StackPanel>
      <StackPanel Grid.Column="0">
        <TextBlock Text="{loc:Loc Group_HashFormat}" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="HashFormatSelector" ItemsSource="{Binding HashFormats}" SelectedItem="{Binding SelectedHashFormat}"
                  DisplayMemberPath="Label" MinHeight="34" AutomationProperties.Name="{loc:Loc Group_HashFormat}" />
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="2" Text="{loc:Loc HashFormatHint}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />
    <TabControl Grid.Row="3">
      <TabItem Header="{loc:Loc ColumnOrderTitle}">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <TextBlock Text="{loc:Loc ColumnOrderHint}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ListBox x:Name="ColumnList" ItemsSource="{Binding Columns}" SelectedItem="{Binding SelectedColumn}"
                     DisplayMemberPath="Label" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Loc ColumnOrderTitle}" />
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
              <Button Content="{loc:Loc MoveFirst}" Command="{Binding MoveFirstCommand}" Style="{StaticResource BandButton}" />
              <Button Content="{loc:Loc MoveUp}" Command="{Binding MoveUpCommand}" Style="{StaticResource BandButton}" />
              <Button Content="{loc:Loc MoveDown}" Command="{Binding MoveDownCommand}" Style="{StaticResource BandButton}" />
              <Button Content="{loc:Loc MoveLast}" Command="{Binding MoveLastCommand}" Style="{StaticResource BandButton}" />
            </StackPanel>
          </Grid>
          <CheckBox x:Name="PathAutoWidthCheckBox" Grid.Row="2" Margin="0,12,0,0"
                    Content="{loc:Loc PathAutoWidth}" IsChecked="{Binding PathAutoWidth, Mode=TwoWay}"
                    ToolTip="{loc:Loc PathAutoWidthHint}" />
          <WrapPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Content="{loc:Loc ResetColumnOrder}" Command="{Binding ResetOrderCommand}" Style="{StaticResource BandButton}" />
            <Button Content="{loc:Loc FitColumns}" Command="{Binding FitColumnsCommand}" Style="{StaticResource BandButton}" />
          </WrapPanel>
        </Grid>
      </TabItem>
      <TabItem x:Name="ExportOptionsTab" Header="{loc:Loc ExportResults}">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <TextBlock Text="{loc:Loc ExportColumnsHint}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
          <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{loc:Loc CsvDelimiterLabel}" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="CsvDelimiterSelector" ItemsSource="{Binding CsvDelimiters}"
                      SelectedItem="{Binding SelectedCsvDelimiter}" DisplayMemberPath="Label"
                      MinHeight="34" Width="220" HorizontalAlignment="Left"
                      AutomationProperties.Name="{loc:Loc CsvDelimiterLabel}" />
            <TextBlock Text="{loc:Loc CsvDelimiterHint}" Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap" Margin="0,6,0,0" />
          </StackPanel>
          <ListBox x:Name="ExportColumnList" Grid.Row="2" ItemsSource="{Binding Columns}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                   AutomationProperties.Name="{loc:Loc ExportColumnsTitle}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsExportSelected, Mode=TwoWay}" Margin="4" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <WrapPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Content="{loc:Loc SelectAllExportColumns}" Command="{Binding SelectAllExportColumnsCommand}" Style="{StaticResource BandButton}" />
            <Button Content="{loc:Loc ClearExportColumns}" Command="{Binding ClearExportColumnsCommand}" Style="{StaticResource BandButton}" />
          </WrapPanel>
        </Grid>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="4" Margin="0,14,0,0">
      <TextBlock Text="{loc:Loc OptionsSavedHint}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
      <TextBlock Text="{Binding SettingsError}" Foreground="#B42318" TextWrapping="Wrap" Margin="0,8,0,0"
                 Visibility="{Binding HasSettingsError, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
    <Button Grid.Row="5" Content="{loc:Loc Close}" IsCancel="True"
            HorizontalAlignment="Right" MinWidth="100" Margin="0,18,0,0" Padding="16,8" />
  </Grid>
</Window>
