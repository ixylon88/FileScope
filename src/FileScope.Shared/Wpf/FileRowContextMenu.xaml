<ContextMenu x:Class="FileScope.Shared.FileRowContextMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FileScope.Shared">
  <Separator x:Name="ActionSeparator" Visibility="Collapsed" />
  <MenuItem Header="{loc:Loc FilePropertiesMenu}" Command="{Binding ShowFilePropertiesCommand}"
            ToolTip="{loc:Loc SingleFileActionHint}" ToolTipService.ShowOnDisabled="True" />
  <MenuItem Header="{loc:Loc ShowInExplorerMenu}" Command="{Binding ShowInExplorerCommand}"
            ToolTip="{loc:Loc SingleFileActionHint}" ToolTipService.ShowOnDisabled="True" />
</ContextMenu>
