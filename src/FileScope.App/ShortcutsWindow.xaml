<Window x:Class="FileScope.App.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FileScope.App.Localization"
        Title="{loc:Loc ShortcutsTitle}" Width="660" Height="760" MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Style="{StaticResource AppWindowStyle}">
  <Window.Resources>
    <Style x:Key="ShortcutKeyCap" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource LineBrush}" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style x:Key="ShortcutKeys" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ShortcutDescription" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="16,0,0,0" />
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Width="44" Height="44" Background="{DynamicResource SystemFillColorAttentionBrush}"
              CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Top">
        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE765;" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextOnAccentFillColorSelectedTextBrush}" />
      </Border>
      <StackPanel Grid.Column="1">
        <TextBlock Text="{loc:Loc ShortcutsTitle}" FontSize="24" FontWeight="SemiBold" />
        <TextBlock x:Name="ShortcutsHintText" Text="{loc:Loc ShortcutsHint}" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
      </StackPanel>
    </Grid>
    <ScrollViewer x:Name="ShortcutsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
      <StackPanel x:Name="ShortcutList" Grid.IsSharedSizeScope="True">
        <TextBlock x:Name="ShortcutsGroupActions" Text="{loc:Loc ShortcutsGroupActions}" Style="{StaticResource GroupHeading}" Margin="0,0,0,8" />
        <Grid Margin="0,0,0,5">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="ShortcutKeys" MaxWidth="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource ShortcutKeyCap}">
            <TextBlock x:Name="ShortcutOpenKeys" Text="{loc:Loc ShortcutOpenKeys}" Style="{StaticResource ShortcutKeys}" />
          </Border>
          <TextBlock x:Name="ShortcutOpenAction" Grid.Column="1" Text="{loc:Loc ShortcutOpenAction}" Style="{StaticResource ShortcutDescription}" />
        </Grid>
        <Grid Margin="0,0,0,5">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="ShortcutKeys" MaxWidth="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource ShortcutKeyCap}">
            <TextBlock x:Name="ShortcutClearKeys" Text="{loc:Loc ShortcutClearKeys}" Style="{StaticResource ShortcutKeys}" />
          </Border>
          <TextBlock x:Name="ShortcutClearAction" Grid.Column="1" Text="{loc:Loc ShortcutClearAction}" Style="{StaticResource ShortcutDescription}" />
        </Grid>
        <Grid Margin="0,0,0,5">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="ShortcutKeys" MaxWidth="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource ShortcutKeyCap}">
            <TextBlock x:Name="ShortcutCancelKeys" Text="{loc:Loc ShortcutCancelKeys}" Style="{StaticResource ShortcutKeys}" />
          </Border>
          <TextBlock x:Name="ShortcutCancelAction" Grid.Column="1" Text="{loc:Loc ShortcutCancelAction}" Style="{StaticResource ShortcutDescription}" />
        </Grid>
        <Grid Margin="0,0,0,5">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="ShortcutKeys" MaxWidth="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource ShortcutKeyCap}">
            <TextBlock x:Name="ShortcutHelpKeys" Text="{loc:Loc ShortcutHelpKeys}" Style="{StaticResource ShortcutKeys}" />
          </Border>
          <TextBlock x:Name="ShortcutHelpAction" Grid.Column="1" Text="{loc:Loc ShortcutHelpAction}" Style="{StaticResource ShortcutDescription}" />
        </Grid>
        <TextBlock x:Name="ShortcutsGroupNavigation" Text="{loc:Loc ShortcutsGroupNavigation}" Style="{StaticResource GroupHeading}" Margin="0,14,0,8" />
        <Grid Margin="0,0,0,5">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="ShortcutKeys" MaxWidth="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource ShortcutKeyCap}">
            <TextBlock x:Name="ShortcutTableEndsKeys" Text="{loc:Loc ShortcutTableEndsKeys}" Style="{StaticResource ShortcutKeys}" />
          </Border>
          <TextBlock x:Name="ShortcutTableEndsAction" Grid.Column="1" Text="{loc:Loc ShortcutTableEndsAction}" Style="{StaticResource ShortcutDescription}" />
        </Grid>
        <Grid Margin="0,0,0,5">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="ShortcutKeys" MaxWidth="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource ShortcutKeyCap}">
            <TextBlock x:Name="ShortcutPageKeys" Text="{loc:Loc ShortcutPageKeys}" Style="{StaticResource ShortcutKeys}" />
          </Border>
          <TextBlock x:Name="ShortcutPageAction" Grid.Column="1" Text="{loc:Loc ShortcutPageAction}" Style="{StaticResource ShortcutDescription}" />
        </Grid>
        <Grid Margin="0,0,0,5">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="ShortcutKeys" MaxWidth="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource ShortcutKeyCap}">
            <TextBlock x:Name="ShortcutRowEndsKeys" Text="{loc:Loc ShortcutRowEndsKeys}" Style="{StaticResource ShortcutKeys}" />
          </Border>
          <TextBlock x:Name="ShortcutRowEndsAction" Grid.Column="1" Text="{loc:Loc ShortcutRowEndsAction}" Style="{StaticResource ShortcutDescription}" />
        </Grid>
        <Grid Margin="0,0,0,5">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="ShortcutKeys" MaxWidth="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource ShortcutKeyCap}">
            <TextBlock x:Name="ShortcutRowsKeys" Text="{loc:Loc ShortcutRowsKeys}" Style="{StaticResource ShortcutKeys}" />
          </Border>
          <TextBlock x:Name="ShortcutRowsAction" Grid.Column="1" Text="{loc:Loc ShortcutRowsAction}" Style="{StaticResource ShortcutDescription}" />
        </Grid>
        <TextBlock x:Name="ShortcutsGroupSelection" Text="{loc:Loc ShortcutsGroupSelection}" Style="{StaticResource GroupHeading}" Margin="0,14,0,8" />
        <Grid Margin="0,0,0,5">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="ShortcutKeys" MaxWidth="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource ShortcutKeyCap}">
            <TextBlock x:Name="ShortcutSelectAllKeys" Text="{loc:Loc ShortcutSelectAllKeys}" Style="{StaticResource ShortcutKeys}" />
          </Border>
          <TextBlock x:Name="ShortcutSelectAllAction" Grid.Column="1" Text="{loc:Loc ShortcutSelectAllAction}" Style="{StaticResource ShortcutDescription}" />
        </Grid>
        <Grid Margin="0,0,0,5">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="ShortcutKeys" MaxWidth="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource ShortcutKeyCap}">
            <TextBlock x:Name="ShortcutExtendKeys" Text="{loc:Loc ShortcutExtendKeys}" Style="{StaticResource ShortcutKeys}" />
          </Border>
          <TextBlock x:Name="ShortcutExtendAction" Grid.Column="1" Text="{loc:Loc ShortcutExtendAction}" Style="{StaticResource ShortcutDescription}" />
        </Grid>
        <Grid Margin="0,0,0,5">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="ShortcutKeys" MaxWidth="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource ShortcutKeyCap}">
            <TextBlock x:Name="ShortcutCopyKeys" Text="{loc:Loc ShortcutCopyKeys}" Style="{StaticResource ShortcutKeys}" />
          </Border>
          <TextBlock x:Name="ShortcutCopyAction" Grid.Column="1" Text="{loc:Loc ShortcutCopyAction}" Style="{StaticResource ShortcutDescription}" />
        </Grid>
        <Grid Margin="0,0,0,5">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="ShortcutKeys" MaxWidth="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource ShortcutKeyCap}">
            <TextBlock x:Name="ShortcutContextMenuKeys" Text="{loc:Loc ShortcutContextMenuKeys}" Style="{StaticResource ShortcutKeys}" />
          </Border>
          <TextBlock x:Name="ShortcutContextMenuAction" Grid.Column="1" Text="{loc:Loc ShortcutContextMenuAction}" Style="{StaticResource ShortcutDescription}" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,18,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock Text="{loc:Loc ShortcutsCloseHint}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,14,0"
                 Foreground="{DynamicResource MutedBrush}" FontSize="12" />
      <Button x:Name="CloseShortcutsButton" Grid.Column="1" Content="{loc:Loc Close}" IsDefault="True" IsCancel="True"
              Click="CloseShortcuts" MinWidth="100" Padding="16,8" />
    </Grid>
  </Grid>
</Window>
