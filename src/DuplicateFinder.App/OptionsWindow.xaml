<Window x:Class="DuplicateFinder.App.OptionsWindow" x:Name="WindowRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DuplicateFinder.App"
        xmlns:shared="clr-namespace:FileScope.Shared;assembly=FileScope.Shared"
        Title="{loc:Loc OptionsTitle}" Style="{StaticResource AppWindowStyle}"
        Width="730" Height="740" MinWidth="640" MinHeight="600" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <shared:OptionsHeader x:Name="DisplayOptions">
      <shared:OptionsHeader.ThemeSelector>
        <ComboBox AutomationProperties.AutomationId="Themes" DisplayMemberPath="Label" SelectedValuePath="Value"
                    AutomationProperties.Name="{loc:Loc Group_Theme}" />
      </shared:OptionsHeader.ThemeSelector>
      <shared:OptionsHeader.HashFormatSelector>
        <ComboBox AutomationProperties.AutomationId="HashFormats" DisplayMemberPath="Label" SelectedValuePath="Value"
                    AutomationProperties.Name="{loc:Loc Group_HashFormat}" />
      </shared:OptionsHeader.HashFormatSelector>
      <shared:OptionsHeader.LanguageSelector>
        <ComboBox AutomationProperties.AutomationId="Languages" DisplayMemberPath="NativeName" SelectedValuePath="CultureName"
                    AutomationProperties.Name="{loc:Loc Group_Language}" />
      </shared:OptionsHeader.LanguageSelector>
    </shared:OptionsHeader>

    <TabControl Grid.Row="1">
      <TabItem x:Name="SearchTab" Header="{loc:Loc SearchFolders}">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="{loc:Loc PriorityHint}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
          <DataGrid x:Name="RootsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                    HeadersVisibility="Column" SelectionMode="Extended" AutomationProperties.Name="{loc:Loc SearchFolders}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{loc:Loc Folder}" Binding="{Binding Path, Mode=OneWay}" Width="*" IsReadOnly="True" />
              <DataGridTextColumn Header="{loc:Loc Priority}" Binding="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Width="120" />
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Grid.Row="2" Margin="0,8,0,6">
            <Button Content="{loc:Loc Add}" Command="{Binding AddFoldersCommand, ElementName=WindowRoot}" Style="{StaticResource BandButton}" />
            <Button Content="{loc:Loc Remove}" Command="{Binding RemoveFoldersCommand, ElementName=WindowRoot}" Style="{StaticResource BandButton}" />
          </WrapPanel>
          <StackPanel Grid.Row="3">
            <TextBlock Text="{loc:Loc IntakeSize}" Style="{StaticResource GroupHeading}" Margin="0,0,0,5" />
            <WrapPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                <Label Content="{loc:Loc SizeFrom}" Target="{Binding ElementName=MinimumSize}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="MinimumSize" Width="90" VerticalContentAlignment="Center" />
                <ComboBox x:Name="MinimumUnit" MinWidth="65" Margin="4,0,0,0" DisplayMemberPath="Value" SelectedValuePath="Key"
                          IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="{loc:Loc MinimumSizeUnit}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <Label Content="{loc:Loc SizeTo}" Target="{Binding ElementName=MaximumSize}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="MaximumSize" Width="90" VerticalContentAlignment="Center" />
                <ComboBox x:Name="MaximumUnit" MinWidth="65" Margin="4,0,0,0" DisplayMemberPath="Value" SelectedValuePath="Key"
                          IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="{loc:Loc MaximumSizeUnit}" />
              </StackPanel>
            </WrapPanel>
            <TextBlock Text="{loc:Loc IntakeSizeHint}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="{loc:Loc Column_Status}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12">
            <TextBlock Text="{loc:Loc Hashes}" Style="{StaticResource GroupHeading}" />
            <WrapPanel x:Name="HashOptions" />
            <CheckBox x:Name="AutoPathWidth" Content="{loc:Loc PathAutoWidth}" ToolTip="{loc:Loc PathAutoWidthHint}" Margin="0,12,0,0" />
            <Separator Margin="0,16" />
            <TextBlock Text="{loc:Loc Signatures}" Style="{StaticResource GroupHeading}" />
            <CheckBox x:Name="Embedded" Content="{loc:Loc SignatureFilterLabel}" Margin="0,0,0,8" />
            <CheckBox x:Name="Catalogs" Content="{loc:Loc Column_Catalog}" Margin="0,0,0,8" />
            <CheckBox x:Name="Online" Content="{loc:Loc OnlineRevocation}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <DockPanel Grid.Row="2" Margin="0,14,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="{loc:Loc Cancel}" IsCancel="True" Command="{Binding CloseCommand, ElementName=WindowRoot}" Style="{StaticResource BandButton}" />
        <Button x:Name="SaveButton" Content="{loc:Loc Save}" IsDefault="True" Command="{Binding SaveCommand, ElementName=WindowRoot}" Style="{StaticResource BandButton}" Margin="0,0,0,6" />
      </StackPanel>
      <TextBlock x:Name="Validation" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                 TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </DockPanel>
  </Grid>
</Window>
