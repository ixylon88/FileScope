<Window x:Class="DuplicateFinder.App.OptionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:FileScope.App.Localization"
 Title="{loc:Loc Options}" Style="{StaticResource AppWindowStyle}" Width="700" Height="575" MinWidth="520" MinHeight="420"
 WindowStartupLocation="CenterOwner">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="{loc:Loc Cancel}" IsCancel="True" Style="{StaticResource BandButton}"/>
      <Button Content="{loc:Loc Save}" IsDefault="True" Click="Save" Style="{StaticResource BandButton}"/>
    </StackPanel>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="{loc:Loc PriorityHint}" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <DataGrid x:Name="RootsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                SelectionMode="Extended">
        <DataGrid.Columns>
          <DataGridTextColumn Header="{loc:Loc Folder}" Binding="{Binding Path, Mode=OneWay}" Width="*" IsReadOnly="True"/>
          <DataGridTextColumn Header="{loc:Loc Priority}" Binding="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
        </DataGrid.Columns>
      </DataGrid>
      <StackPanel Grid.Row="2">
        <WrapPanel Margin="0,8,0,4">
          <Button Content="{loc:Loc Add}" Click="AddFolders" Style="{StaticResource BandButton}"/>
          <Button Content="{loc:Loc Remove}" Click="RemoveFolders" Style="{StaticResource BandButton}"/>
        </WrapPanel>
        <TextBlock Text="{loc:Loc Hashes}" FontWeight="SemiBold"/>
        <WrapPanel x:Name="HashOptions" Margin="0,4,0,7"/>
        <WrapPanel>
          <CheckBox x:Name="Embedded" Content="{loc:Loc Embedded}" Margin="0,4,16,4"/>
          <CheckBox x:Name="Catalogs" Content="{loc:Loc Catalog}" Margin="0,4,16,4"/>
          <CheckBox x:Name="Online" Content="{loc:Loc Online}" Margin="0,4,0,4"/>
        </WrapPanel>
        <WrapPanel Margin="0,8,0,0">
          <TextBlock Text="{loc:Loc Language}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox x:Name="Languages" MinWidth="125" DisplayMemberPath="NativeName" SelectedValuePath="CultureName"/>
          <TextBlock Text="{loc:Loc Theme}" VerticalAlignment="Center" Margin="18,0,8,0"/>
          <ComboBox x:Name="Themes" MinWidth="115"/>
        </WrapPanel>
        <TextBlock x:Name="Validation" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
