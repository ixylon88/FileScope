<Window x:Class="FileScope.Shared.Dialogs.ReportDialog" x:Name="WindowRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FileScope.Shared.Localization"
        Width="700" Height="455" MinWidth="450" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindowStyle}"
        Language="{Binding Culture.IetfLanguageTag, Source={x:Static loc:LocalizationService.Instance}, Mode=OneWay, ConverterCulture=en-US}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="SummaryText" Margin="0,0,0,14" TextWrapping="Wrap" FontWeight="SemiBold"
               Foreground="{DynamicResource MutedBrush}" />

    <TextBox x:Name="ReportText" Grid.Row="1" Visibility="Collapsed" IsReadOnly="True" AcceptsReturn="True"
             TextWrapping="NoWrap" FontFamily="Consolas" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
             AutomationProperties.Name="{Binding Title, ElementName=WindowRoot}" />
    <ListBox x:Name="Lines" Grid.Row="1" Visibility="Collapsed"
             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
             ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto"
             AutomationProperties.Name="{Binding Title, ElementName=WindowRoot}" />

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="CloseButton" Content="{loc:Loc Close}" IsCancel="True" IsDefault="True" Padding="18,7"
              Command="{Binding CloseCommand, ElementName=WindowRoot}" />
      <Button x:Name="ConfirmButton" Visibility="Collapsed" Padding="18,7" Margin="8,0,0,0"
              Command="{Binding ConfirmCommand, ElementName=WindowRoot}" />
    </StackPanel>
  </Grid>
</Window>
