<DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           mc:Ignorable="d" d:DesignWidth="640" Margin="0,14,0,0">
  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
    <Button x:Name="CancelButton" Content="{Binding Strings[Cancel]}" d:Content="Cancel"
            IsCancel="True" Command="{Binding CancelCommand}"
            MinWidth="90" Padding="12,7" Margin="0,0,8,0" />
    <Button x:Name="SaveButton" Content="{Binding Strings[Save]}" d:Content="Save"
            IsDefault="True" Command="{Binding SaveCommand}"
            MinWidth="90" Padding="12,7" />
  </StackPanel>

  <StackPanel VerticalAlignment="Bottom">
    <TextBlock x:Name="PreviewHint" Text="{Binding Strings[OptionsPreviewHint]}" d:Text="Save or cancel your changes."
               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
    <TextBlock x:Name="ErrorMessage" Visibility="Collapsed" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
               d:Visibility="Visible" d:Text="The settings could not be saved."
               TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
  </StackPanel>
</DockPanel>
