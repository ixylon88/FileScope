<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- INFO: https://github.com/dotnet/wpf/blob/main/Documentation/docs/using-fluent.md -->
  <SolidColorBrush x:Key="MutedBrush" Color="#d6d0d5" />
  <SolidColorBrush x:Key="LineBrush" Color="#a5a9a0" />
  <!-- Scale only the cross-axis: Fluent's 12-DIP bars occupy 24 DIPs,
       including the thumb and its hit area. Keep the native templates,
       colors, range, viewport and scrolling direction unchanged. -->
  <Style x:Key="ScrollBarStyle" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource {x:Type ScrollBar}}">
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Vertical">
        <Setter Property="LayoutTransform">
          <Setter.Value><ScaleTransform ScaleX="2" ScaleY="1" /></Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="LayoutTransform">
          <Setter.Value><ScaleTransform ScaleX="1" ScaleY="2" /></Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style BasedOn="{StaticResource ScrollBarStyle}" TargetType="{x:Type ScrollBar}" /> <!-- reference previously introduced key; intentionally, to prevent infinite ref loop for the case without key and without this line -->
  <Style x:Key="AppWindowStyle" TargetType="Window" BasedOn="{StaticResource {x:Type Window}}">
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="UseLayoutRounding" Value="True" />
  </Style>
  <Style x:Key="GroupHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="Margin" Value="0,0,0,5" />
  </Style>
  <Style x:Key="BandButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Margin" Value="0,0,8,6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style x:Key="GridText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Margin" Value="9,7" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
  </Style>
  <Style x:Key="HashText" TargetType="TextBlock" BasedOn="{StaticResource GridText}">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style x:Key="NameText" TargetType="TextBlock" BasedOn="{StaticResource GridText}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
</ResourceDictionary>
