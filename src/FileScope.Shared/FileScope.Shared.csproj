<Project Sdk="Microsoft.NET.Sdk">
  
  <PropertyGroup>
    <!-- The XAML designer uses the first target. Portable callers still select net10.0. -->
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <UseWPF Condition="'$(TargetFramework)' == 'net10.0-windows'">true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks Condition="'$(UseWPF)' == 'true'">true</AllowUnsafeBlocks>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  
  <ItemGroup>
    <ProjectReference Include="../FileScope.Core/FileScope.Core.csproj" />
  </ItemGroup>
  
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- These controls and services belong to the Windows build. -->
    <Compile Remove="Controls/**/*.cs;Dialogs/**/*.cs;Services/**/*.cs" />
    <Compile Remove="Abstractions/IExternalLinkService.cs;Abstractions/IFileShellService.cs" />
    <Compile Remove="Infrastructure/FileShellCommands.cs;Localization/LocExtension.cs;Presentation/WindowPlacement.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework.EndsWith(`windows`))'">
    <!-- The portable SDK already imports System.IO. -->
    <Using Include="System.IO" />
    <!-- Nest the host under its classless layout in Solution Explorer. -->
    <Compile Update="Controls/OptionsFooterHost.cs" DependentUpon="OptionsFooter.xaml" />
    <Page Include="../DesignTimeResources.xaml" Link="Properties/DesignTimeResources.xaml"
          Generator="MSBuild:Compile" SubType="Designer" ContainsDesignTimeResources="true" />
  </ItemGroup>
  
</Project>
