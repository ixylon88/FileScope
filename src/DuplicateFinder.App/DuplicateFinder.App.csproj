<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Resources/DuplicateFinder.ico</ApplicationIcon>
    <NeutralLanguage>en</NeutralLanguage>
    <Product>DuplicateFinder</Product>
    <Description>Find and safely recycle duplicate files across prioritized search folders.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DuplicateFinder.Core/DuplicateFinder.Core.csproj" />
    <InternalsVisibleTo Include="DuplicateFinder.Ui.Tests" />
    <ProjectReference Include="../FileScope.Shared/FileScope.Shared.csproj" />
    <Resource Include="Resources/DuplicateFinder.ico" />
    <None Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="DuplicateFinder.App.LICENSE" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="FileScope.Shared" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseWPF)' == 'true'">
    <Page Include="../DesignTimeResources.xaml" Link="Properties/DesignTimeResources.xaml"
          Generator="MSBuild:Compile" SubType="Designer" ContainsDesignTimeResources="true" />
  </ItemGroup>
</Project>
