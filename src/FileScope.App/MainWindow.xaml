<Window x:Class="FileScope.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FileScope.App.Localization"
        xmlns:behaviors="clr-namespace:FileScope.App.Behaviors"
        xmlns:vm="clr-namespace:FileScope.App.ViewModels"
        xmlns:infra="clr-namespace:FileScope.App.Infrastructure"
        Title="{loc:Loc WindowTitle}" Width="1440" Height="900" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" Language="{Binding UiLanguage}" Style="{StaticResource AppWindowStyle}"
        behaviors:FileDropBehavior.Command="{Binding DropFilesCommand}">
  <Window.Resources>
    <infra:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />
    <!-- Keep the Fluent header's sort indicators and resize/reorder behavior. -->
    <Style x:Key="ResultsColumnHeaderStyle" TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
      <Setter Property="Background" Value="{DynamicResource HeaderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}" />
      <Setter Property="Padding" Value="9,10" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="SeparatorBrush" Value="{DynamicResource LineBrush}" />
    </Style>
  </Window.Resources>
  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding BrowseCommand}" />
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    <KeyBinding Key="L" Modifiers="Control" Command="{Binding ClearCommand}" />
  </Window.InputBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="*" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="24,20,24,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Border Width="44" Height="44" Background="{DynamicResource AccentBrush}" CornerRadius="12" Margin="0,0,14,0">
        <TextBlock Text="FS" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1">
        <TextBlock Text="FileScope" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="{loc:Loc Subtitle}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
      </StackPanel>
      <TextBlock Grid.Column="2" Text="{Binding Statistics}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
    </Grid>

    <Border Grid.Row="1" Margin="24,0,24,18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal">
          <StackPanel Width="248">
            <TextBlock Text="{loc:Loc Group_Files}" Style="{StaticResource GroupHeading}" />
            <WrapPanel>
              <Button Content="{loc:Loc AddFiles}" Command="{Binding BrowseCommand}" Style="{StaticResource PrimaryButton}" ToolTip="{loc:Loc AddFilesTip}" />
              <Button Content="{loc:Loc Reanalyse}" Command="{Binding ReanalyseCommand}" Style="{StaticResource BandButton}" ToolTip="{loc:Loc ReanalyseTip}" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal">
              <Button Content="{loc:Loc Clear}" Command="{Binding ClearCommand}" Style="{StaticResource BandButton}" ToolTip="{loc:Loc ClearTip}" />
              <Button Content="{loc:Loc Cancel}" Command="{Binding CancelCommand}" Style="{StaticResource BandButton}" ToolTip="{loc:Loc CancelTip}" />
            </StackPanel>
          </StackPanel>
          <Border Width="1" Background="{DynamicResource LineBrush}" Margin="0,0,18,0" />
          <StackPanel Width="224" Margin="0,0,16,0">
            <TextBlock Text="{loc:Loc Group_Checksums}" Style="{StaticResource GroupHeading}" />
            <ItemsControl ItemsSource="{Binding ChecksumOptions}" IsEnabled="{Binding IsIdle}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" MinWidth="106" Margin="0,4,0,10" /></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <Border Width="1" Background="{DynamicResource LineBrush}" Margin="0,0,18,0" />
          <StackPanel Width="292" Margin="0,0,16,0">
            <TextBlock Text="{loc:Loc Group_Certificates}" Style="{StaticResource GroupHeading}" />
            <CheckBox Content="{loc:Loc InspectCertificates}" IsChecked="{Binding InspectCertificates}" IsEnabled="{Binding IsIdle}" Margin="0,4,0,10" ToolTip="{loc:Loc InspectCertificatesTip}" />
            <CheckBox Content="{loc:Loc OnlineRevocation}" IsChecked="{Binding OnlineRevocation}" IsEnabled="{Binding CanChooseOnlineRevocation}" ToolTip="{loc:Loc OnlineRevocationTip}" />
            <TextBlock Text="{loc:Loc CertificateScope}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <Border Width="1" Background="{DynamicResource LineBrush}" Margin="0,0,18,0" />
          <StackPanel Width="146">
            <TextBlock Text="{loc:Loc Group_Language}" Style="{StaticResource GroupHeading}" />
            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="NativeName" MinHeight="34" AutomationProperties.Name="{loc:Loc Group_Language}" />
            <TextBlock Text="{loc:Loc Group_Theme}" Style="{StaticResource FieldLabel}" Margin="0,10,0,5" />
            <ComboBox x:Name="ThemeSelector" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" DisplayMemberPath="Label" MinHeight="34" AutomationProperties.Name="{loc:Loc Group_Theme}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="2" Margin="24,0,24,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="174" /><ColumnDefinition Width="244" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,14,0">
        <TextBlock Text="{loc:Loc SearchLabel}" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" MinHeight="34" Padding="9,5" ToolTip="{loc:Loc SearchTip}" AutomationProperties.Name="{loc:Loc SearchLabel}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,14,0">
        <TextBlock Text="{loc:Loc StateFilterLabel}" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding StateFilters}" SelectedItem="{Binding StateFilter}" DisplayMemberPath="Label" MinHeight="34" AutomationProperties.Name="{loc:Loc StateFilterLabel}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Margin="0,0,14,0">
        <TextBlock Text="{loc:Loc SignatureFilterLabel}" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding SignatureFilters}" SelectedItem="{Binding SignatureFilterOption}" DisplayMemberPath="Label" MinHeight="34" AutomationProperties.Name="{loc:Loc SignatureFilterLabel}" />
      </StackPanel>
      <Button Grid.Column="3" Content="{loc:Loc ResetFilters}" Command="{Binding ResetFiltersCommand}" VerticalAlignment="Bottom" Padding="12,7" MinHeight="34" />
    </Grid>

    <Border Grid.Row="3" Margin="24,0,24,12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
      <Grid>
        <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding RowsView}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
                  CanUserSortColumns="True" SelectionMode="Extended" SelectionUnit="FullRow" FrozenColumnCount="2"
                  HeadersVisibility="Column" RowBackground="{DynamicResource RowBrush}" AlternatingRowBackground="{DynamicResource AlternateRowBrush}" AlternationCount="2"
                  RowStyle="{StaticResource ResultsRowStyle}" CellStyle="{StaticResource ResultsCellStyle}" ColumnHeaderStyle="{StaticResource ResultsColumnHeaderStyle}"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}" BorderThickness="0" Background="{DynamicResource RowBrush}" Foreground="{DynamicResource TextBrush}"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                  ClipboardCopyMode="IncludeHeader" AutomationProperties.Name="{loc:Loc ResultsLabel}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{loc:Loc Column_Name}" Binding="{Binding FileName}" Width="215" ElementStyle="{StaticResource NameText}" />
            <DataGridTemplateColumn Header="{loc:Loc Column_Status}" Width="148" SortMemberPath="State" ClipboardContentBinding="{Binding StateText}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Margin="8,5" Padding="8,3" CornerRadius="5" HorizontalAlignment="Left">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource StatusQueuedBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RowStatus.Completed}"><Setter Property="Background" Value="{DynamicResource StatusCompletedBrush}" /></DataTrigger>
                          <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RowStatus.Running}"><Setter Property="Background" Value="{DynamicResource StatusRunningBrush}" /></DataTrigger>
                          <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RowStatus.Failed}"><Setter Property="Background" Value="{DynamicResource StatusFailedBrush}" /></DataTrigger>
                          <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RowStatus.Cancelled}"><Setter Property="Background" Value="{DynamicResource StatusCancelledBrush}" /></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StateText}" FontSize="12" Foreground="{DynamicResource StatusTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StateText}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{loc:Loc Column_Size}" Binding="{Binding SizeText}" SortMemberPath="Length" Width="116" ElementStyle="{StaticResource GridText}" />
            <DataGridTextColumn Header="{loc:Loc Column_Signature}" Binding="{Binding SignatureText}"
                                Visibility="{Binding Data.InspectCertificates, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" Width="245" ElementStyle="{StaticResource GridText}" />
            <DataGridTextColumn Header="{loc:Loc Column_Publisher}" Binding="{Binding Publisher}"
                                Visibility="{Binding Data.InspectCertificates, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" Width="245" ElementStyle="{StaticResource GridText}" />
            <DataGridTextColumn Header="MD5" Binding="{Binding MD5}"
                                Visibility="{Binding Data.ShowMD5Column, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" Width="254" ElementStyle="{StaticResource HashText}" />
            <DataGridTextColumn Header="SHA-1" Binding="{Binding SHA1}"
                                Visibility="{Binding Data.ShowSHA1Column, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" Width="310" ElementStyle="{StaticResource HashText}" />
            <DataGridTextColumn Header="SHA-256" Binding="{Binding SHA256}"
                                Visibility="{Binding Data.ShowSHA256Column, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" Width="470" ElementStyle="{StaticResource HashText}" />
            <DataGridTextColumn Header="SHA-384" Binding="{Binding SHA384}"
                                Visibility="{Binding Data.ShowSHA384Column, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" Width="690" ElementStyle="{StaticResource HashText}" />
            <DataGridTextColumn Header="SHA-512" Binding="{Binding SHA512}"
                                Visibility="{Binding Data.ShowSHA512Column, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" Width="910" ElementStyle="{StaticResource HashText}" />
            <DataGridTextColumn Header="{loc:Loc Column_Modified}" Binding="{Binding ModifiedText}" SortMemberPath="Result.LastWriteTime" Width="170" ElementStyle="{StaticResource GridText}" />
            <DataGridTextColumn Header="{loc:Loc Column_Path}" Binding="{Binding FullPath}" Width="390" ElementStyle="{StaticResource GridText}" />
            <DataGridTextColumn Header="{loc:Loc Column_Subject}" Binding="{Binding Subject}"
                                Visibility="{Binding Data.InspectCertificates, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" Width="390" ElementStyle="{StaticResource GridText}" />
            <DataGridTextColumn Header="{loc:Loc Column_Issuer}" Binding="{Binding Issuer}"
                                Visibility="{Binding Data.InspectCertificates, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" Width="390" ElementStyle="{StaticResource GridText}" />
            <DataGridTextColumn Header="{loc:Loc Column_Serial}" Binding="{Binding SerialNumber}"
                                Visibility="{Binding Data.InspectCertificates, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" Width="290" ElementStyle="{StaticResource HashText}" />
            <DataGridTextColumn Header="{loc:Loc Column_ValidFrom}" Binding="{Binding ValidFrom}"
                                Visibility="{Binding Data.InspectCertificates, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" SortMemberPath="Result.Signature.Certificate.NotBefore" Width="175" ElementStyle="{StaticResource GridText}" />
            <DataGridTextColumn Header="{loc:Loc Column_ValidUntil}" Binding="{Binding ValidUntil}"
                                Visibility="{Binding Data.InspectCertificates, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" SortMemberPath="Result.Signature.Certificate.NotAfter" Width="175" ElementStyle="{StaticResource GridText}" />
            <DataGridTextColumn Header="{loc:Loc Column_CertSha1}" Binding="{Binding CertificateSha1}"
                                Visibility="{Binding Data.InspectCertificates, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" Width="310" ElementStyle="{StaticResource HashText}" />
            <DataGridTextColumn Header="{loc:Loc Column_CertSha256}" Binding="{Binding CertificateSha256}"
                                Visibility="{Binding Data.InspectCertificates, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" Width="470" ElementStyle="{StaticResource HashText}" />
            <DataGridTextColumn Header="{loc:Loc Column_CertAlgorithm}" Binding="{Binding CertificateAlgorithm}"
                                Visibility="{Binding Data.InspectCertificates, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" Width="210" ElementStyle="{StaticResource GridText}" />
            <DataGridTextColumn Header="{loc:Loc Column_NativeCode}" Binding="{Binding NativeCode}"
                                Visibility="{Binding Data.InspectCertificates, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" Width="150" ElementStyle="{StaticResource HashText}" />
            <DataGridTextColumn Header="{loc:Loc Column_Diagnostic}" Binding="{Binding Diagnostic}" Width="440" ElementStyle="{StaticResource GridText}" />
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}" Margin="30">
          <TextBlock Text="↓" FontSize="48" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
          <TextBlock Text="{loc:Loc DropTitle}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="{loc:Loc DropHint}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" TextAlignment="Center" />
          <TextBlock Text="{loc:Loc DropOptionsHint}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,7,0,0" TextAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{loc:Loc NoMatches}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"
                   Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"
                   Visibility="{Binding ShowNoMatches, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </Border>

    <Expander Grid.Row="4" Header="{loc:Loc DetailsTitle}" Margin="24,0,24,12" IsExpanded="False">
      <TextBox Text="{Binding SelectedRow.Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" MinHeight="90" MaxHeight="160"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
               FontSize="12" Padding="12" Background="{DynamicResource SurfaceBrush}" ToolTip="{loc:Loc DetailsHint}" AutomationProperties.Name="{loc:Loc DetailsTitle}" />
    </Expander>

    <Border Grid.Row="5" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
      <StackPanel>
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
          <TextBlock Grid.Column="1" Text="{Binding CurrentFile}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" ToolTip="{Binding CurrentFile}" />
        </Grid>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsCheckingSignature}" Height="4" Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="{loc:Loc ProgressLabel}" />
        <TextBlock Text="{Binding LastError}" Foreground="{DynamicResource ErrorBrush}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
