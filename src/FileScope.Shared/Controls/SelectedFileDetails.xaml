<UserControl x:Class="FileScope.Shared.Controls.SelectedFileDetails" x:Name="DetailsRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FileScope.Shared.Localization"
             Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch">
  <Expander x:Name="DetailsExpander" IsExpanded="False" HorizontalContentAlignment="Stretch">
    <Expander.Header>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="DetailsLabel" Text="{loc:Loc DetailsTitle}" VerticalAlignment="Center" />
        <TextBlock x:Name="DetailsPath" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                   Text="{Binding FilePath, ElementName=DetailsRoot}"
                   ToolTip="{Binding FilePath, ElementName=DetailsRoot}" />
      </Grid>
    </Expander.Header>

    <TextBox x:Name="DetailsBox" Text="{Binding DetailsText, ElementName=DetailsRoot, Mode=OneWay}"
             IsReadOnly="True" TextWrapping="NoWrap" MinHeight="90" MaxHeight="160" Padding="12"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
             FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="12"
             ToolTip="{loc:Loc DetailsHint}" AutomationProperties.Name="{loc:Loc DetailsTitle}" />
  </Expander>
</UserControl>
