<DockPanel x:Class="FileScope.Shared.OptionsFooter"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:loc="clr-namespace:FileScope.Shared"
           Margin="0,14,0,0">
  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
    <Button x:Name="CancelButton" Content="{loc:Loc Cancel}" IsCancel="True"
            Command="{Binding CancelCommand, RelativeSource={RelativeSource AncestorType={x:Type loc:OptionsFooter}}}"
            MinWidth="90" Padding="12,7" Margin="0,0,8,0" />
    <Button x:Name="SaveButton" Content="{loc:Loc Save}" IsDefault="True"
            Command="{Binding SaveCommand, RelativeSource={RelativeSource AncestorType={x:Type loc:OptionsFooter}}}"
            MinWidth="90" Padding="12,7" />
  </StackPanel>

  <StackPanel VerticalAlignment="Bottom">
    <TextBlock x:Name="PreviewHint" Text="{loc:Loc OptionsPreviewHint}" Foreground="{DynamicResource MutedBrush}"
               TextWrapping="Wrap" Margin="0,4,0,0" />
    <TextBlock x:Name="ErrorMessage" Visibility="Collapsed" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
               TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
  </StackPanel>
</DockPanel>
