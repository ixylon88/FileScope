<Window x:Class="FileScope.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FileScope.App.Localization"
        xmlns:behaviors="clr-namespace:FileScope.App.Behaviors"
        xmlns:controls="clr-namespace:FileScope.App.Controls"
        xmlns:infra="clr-namespace:FileScope.App.Infrastructure"
        Title="{loc:Loc WindowTitle}" Width="1440" Height="900" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="Manual" Language="{Binding UiLanguage}" Style="{StaticResource AppWindowStyle}"
        behaviors:FileDropBehavior.Command="{Binding DropFilesCommand}">
  <Window.Resources>
    <infra:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />
    <infra:StatusToneConverter x:Key="StatusToneConverter" />
  </Window.Resources>
  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding BrowseCommand}" />
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    <KeyBinding Key="L" Modifiers="Control" Command="{Binding ClearCommand}" />
  </Window.InputBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="*" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="24,20,24,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Border Width="44" Height="44" Background="{StaticResource AccentBrush}" CornerRadius="12" Margin="0,0,14,0">
        <TextBlock Text="FS" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1">
        <TextBlock Text="FileScope" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="{loc:Loc Subtitle}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
      </StackPanel>
      <TextBlock Grid.Column="2" Text="{Binding Statistics}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
    </Grid>

    <Border Grid.Row="1" Margin="24,0,24,18" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal">
          <StackPanel Width="248">
            <TextBlock Text="{loc:Loc Group_Files}" Style="{StaticResource GroupHeading}" />
            <WrapPanel>
              <Button Content="{loc:Loc AddFiles}" Command="{Binding BrowseCommand}" Style="{StaticResource PrimaryButton}" ToolTip="{loc:Loc AddFilesTip}" />
              <Button Content="{loc:Loc Reanalyse}" Command="{Binding ReanalyseCommand}" Style="{StaticResource BandButton}" ToolTip="{loc:Loc ReanalyseTip}" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal">
              <Button Content="{loc:Loc Clear}" Command="{Binding ClearCommand}" Style="{StaticResource BandButton}" ToolTip="{loc:Loc ClearTip}" />
              <Button Content="{loc:Loc Cancel}" Command="{Binding CancelCommand}" Style="{StaticResource BandButton}" ToolTip="{loc:Loc CancelTip}" />
            </StackPanel>
          </StackPanel>
          <Border Width="1" Background="{StaticResource LineBrush}" Margin="0,0,18,0" />
          <StackPanel Width="224" Margin="0,0,16,0">
            <TextBlock Text="{loc:Loc Group_Checksums}" Style="{StaticResource GroupHeading}" />
            <ItemsControl ItemsSource="{Binding ChecksumOptions}" IsEnabled="{Binding IsIdle}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" MinWidth="106" Margin="0,4,0,10" /></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <Border Width="1" Background="{StaticResource LineBrush}" Margin="0,0,18,0" />
          <StackPanel Width="292" Margin="0,0,16,0">
            <TextBlock Text="{loc:Loc Group_Certificates}" Style="{StaticResource GroupHeading}" />
            <CheckBox Content="{loc:Loc InspectCertificates}" IsChecked="{Binding InspectCertificates}" IsEnabled="{Binding IsIdle}" Margin="0,4,0,10" ToolTip="{loc:Loc InspectCertificatesTip}" />
            <CheckBox Content="{loc:Loc OnlineRevocation}" IsChecked="{Binding OnlineRevocation}" IsEnabled="{Binding CanChooseOnlineRevocation}" ToolTip="{loc:Loc OnlineRevocationTip}" />
            <TextBlock Text="{loc:Loc CertificateScope}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <Border Width="1" Background="{StaticResource LineBrush}" Margin="0,0,18,0" />
          <StackPanel Width="146">
            <Button x:Name="OptionsButton" Click="OpenOptions" Style="{StaticResource BandButton}"
                    ToolTip="{loc:Loc OptionsTitle}" AutomationProperties.Name="{loc:Loc OptionsTitle}">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{loc:Loc OptionsTitle}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="2" Margin="24,0,24,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="174" /><ColumnDefinition Width="244" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,14,0">
        <TextBlock Text="{loc:Loc SearchLabel}" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" MinHeight="34" Padding="9,5" ToolTip="{loc:Loc SearchTip}" AutomationProperties.Name="{loc:Loc SearchLabel}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,14,0">
        <TextBlock Text="{loc:Loc StateFilterLabel}" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding StateFilters}" SelectedItem="{Binding StateFilter}" DisplayMemberPath="Label" MinHeight="34" AutomationProperties.Name="{loc:Loc StateFilterLabel}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Margin="0,0,14,0">
        <TextBlock Text="{loc:Loc SignatureFilterLabel}" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding SignatureFilters}" SelectedItem="{Binding SignatureFilterOption}" DisplayMemberPath="Label" MinHeight="34" AutomationProperties.Name="{loc:Loc SignatureFilterLabel}" />
      </StackPanel>
      <Button Grid.Column="3" Content="{loc:Loc ResetFilters}" Command="{Binding ResetFiltersCommand}" VerticalAlignment="Bottom" Padding="12,7" MinHeight="34" />
    </Grid>

    <Border Grid.Row="3" Margin="24,0,24,12" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
      <Grid>
        <DataGrid x:Name="ResultsGrid" Loaded="OnResultsGridLoaded" behaviors:ColumnLayoutBehavior.Options="{Binding Options}"
                  behaviors:ColumnLayoutBehavior.FitRevision="{Binding Options.WidthRevision}" ItemsSource="{Binding RowsView}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
                  CanUserSortColumns="True" SelectionMode="Extended" SelectionUnit="FullRow" FrozenColumnCount="2"
                  HeadersVisibility="Column" RowBackground="#FFFFFF" AlternationCount="0"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E1E6EE" BorderThickness="0" Background="#FFFFFF" Foreground="#1C273B"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                  ClipboardCopyMode="IncludeHeader" AutomationProperties.Name="{loc:Loc ResultsLabel}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{loc:Loc Column_Name}" Binding="{Binding FileName}" behaviors:ColumnLayoutBehavior.Id="Name" Width="Auto" MinWidth="150" MaxWidth="340" ElementStyle="{StaticResource NameText}" />
            <DataGridTemplateColumn Header="{loc:Loc Column_Status}" behaviors:ColumnLayoutBehavior.Id="Status" Width="Auto" MinWidth="110" MaxWidth="250" SortMemberPath="State" ClipboardContentBinding="{Binding StateText}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <controls:StatusBadge Text="{Binding StateText}"
                                        Tone="{Binding State, Converter={StaticResource StatusToneConverter}}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{loc:Loc Column_Size}" Binding="{Binding SizeText}" SortMemberPath="Length" behaviors:ColumnLayoutBehavior.Id="Size" Width="Auto" MinWidth="100" MaxWidth="170" ElementStyle="{StaticResource GridText}" />
            <DataGridTemplateColumn Header="{loc:Loc Column_SignatureChoice}" behaviors:ColumnLayoutBehavior.Id="SignatureChoice"
                                    Width="Auto" MinWidth="180" MaxWidth="480" SortMemberPath="SignatureChoiceText"
                                    ClipboardContentBinding="{Binding SignatureChoiceText}"
                                    Visibility="{Binding Data.ShowSignatureSelectorColumn, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ComboBox ItemsSource="{Binding Signatures}" SelectedItem="{Binding SelectedSignature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            DisplayMemberPath="Label" IsEnabled="{Binding HasMultipleSignatures}" Margin="5,3" MinWidth="160"
                            ToolTip="{loc:Loc SignatureChoiceHint}" AutomationProperties.Name="{loc:Loc Column_SignatureChoice}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{loc:Loc Column_SigningTime}" Binding="{Binding SigningTimeText}" SortMemberPath="SigningTime"
                                Visibility="{Binding Data.InspectCertificates, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}"
                                behaviors:ColumnLayoutBehavior.Id="SigningTime" Width="Auto" MinWidth="180" MaxWidth="380" ElementStyle="{StaticResource GridText}" />
            <DataGridTemplateColumn Header="{loc:Loc Column_Signature}" SortMemberPath="SignatureText"
                                    ClipboardContentBinding="{Binding SignatureText}"
                                    Visibility="{Binding Data.InspectCertificates, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}"
                                    behaviors:ColumnLayoutBehavior.Id="Signature" Width="Auto" MinWidth="160" MaxWidth="360">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <controls:StatusBadge Text="{Binding SignatureText}"
                                        Tone="{Binding SignatureState, Converter={StaticResource StatusToneConverter}}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{loc:Loc Column_Publisher}" Binding="{Binding Publisher}"
                                Visibility="{Binding Data.InspectCertificates, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" behaviors:ColumnLayoutBehavior.Id="Publisher" Width="Auto" MinWidth="150" MaxWidth="360" ElementStyle="{StaticResource GridText}" />
            <DataGridTextColumn Header="MD5" Binding="{Binding MD5}"
                                Visibility="{Binding Data.ShowMD5Column, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" behaviors:ColumnLayoutBehavior.Id="MD5" Width="Auto" MinWidth="150" MaxWidth="340" ElementStyle="{StaticResource HashText}" />
            <DataGridTextColumn Header="SHA-1" Binding="{Binding SHA1}"
                                Visibility="{Binding Data.ShowSHA1Column, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" behaviors:ColumnLayoutBehavior.Id="SHA1" Width="Auto" MinWidth="150" MaxWidth="420" ElementStyle="{StaticResource HashText}" />
            <DataGridTextColumn Header="SHA-256" Binding="{Binding SHA256}"
                                Visibility="{Binding Data.ShowSHA256Column, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" behaviors:ColumnLayoutBehavior.Id="SHA256" Width="Auto" MinWidth="170" MaxWidth="560" ElementStyle="{StaticResource HashText}" />
            <DataGridTextColumn Header="SHA-384" Binding="{Binding SHA384}"
                                Visibility="{Binding Data.ShowSHA384Column, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" behaviors:ColumnLayoutBehavior.Id="SHA384" Width="Auto" MinWidth="170" MaxWidth="640" ElementStyle="{StaticResource HashText}" />
            <DataGridTextColumn Header="SHA-512" Binding="{Binding SHA512}"
                                Visibility="{Binding Data.ShowSHA512Column, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" behaviors:ColumnLayoutBehavior.Id="SHA512" Width="Auto" MinWidth="170" MaxWidth="720" ElementStyle="{StaticResource HashText}" />
            <DataGridTextColumn Header="{loc:Loc Column_Modified}" Binding="{Binding ModifiedText}" SortMemberPath="Result.LastWriteTime" behaviors:ColumnLayoutBehavior.Id="Modified" Width="Auto" MinWidth="150" MaxWidth="240" ElementStyle="{StaticResource GridText}" />
            <DataGridTextColumn Header="{loc:Loc Column_Path}" Binding="{Binding FullPath}" behaviors:ColumnLayoutBehavior.Id="Path" Width="Auto" MinWidth="220" MaxWidth="600" ElementStyle="{StaticResource GridText}" />
            <DataGridTextColumn Header="{loc:Loc Column_Subject}" Binding="{Binding Subject}"
                                Visibility="{Binding Data.InspectCertificates, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" behaviors:ColumnLayoutBehavior.Id="Subject" Width="Auto" MinWidth="180" MaxWidth="500" ElementStyle="{StaticResource GridText}" />
            <DataGridTextColumn Header="{loc:Loc Column_Issuer}" Binding="{Binding Issuer}"
                                Visibility="{Binding Data.InspectCertificates, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" behaviors:ColumnLayoutBehavior.Id="Issuer" Width="Auto" MinWidth="180" MaxWidth="500" ElementStyle="{StaticResource GridText}" />
            <DataGridTextColumn Header="{loc:Loc Column_Serial}" Binding="{Binding SerialNumber}"
                                Visibility="{Binding Data.InspectCertificates, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" behaviors:ColumnLayoutBehavior.Id="Serial" Width="Auto" MinWidth="140" MaxWidth="360" ElementStyle="{StaticResource HashText}" />
            <DataGridTextColumn Header="{loc:Loc Column_ValidFrom}" Binding="{Binding ValidFrom}"
                                Visibility="{Binding Data.InspectCertificates, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" SortMemberPath="ValidFromDate" behaviors:ColumnLayoutBehavior.Id="ValidFrom" Width="Auto" MinWidth="150" MaxWidth="240" ElementStyle="{StaticResource GridText}" />
            <DataGridTextColumn Header="{loc:Loc Column_ValidUntil}" Binding="{Binding ValidUntil}"
                                Visibility="{Binding Data.InspectCertificates, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" SortMemberPath="ValidUntilDate" behaviors:ColumnLayoutBehavior.Id="ValidUntil" Width="Auto" MinWidth="150" MaxWidth="240" ElementStyle="{StaticResource GridText}" />
            <DataGridTextColumn Header="{loc:Loc Column_CertSha1}" Binding="{Binding CertificateSha1}"
                                Visibility="{Binding Data.InspectCertificates, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" behaviors:ColumnLayoutBehavior.Id="CertSha1" Width="Auto" MinWidth="170" MaxWidth="420" ElementStyle="{StaticResource HashText}" />
            <DataGridTextColumn Header="{loc:Loc Column_CertSha256}" Binding="{Binding CertificateSha256}"
                                Visibility="{Binding Data.InspectCertificates, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" behaviors:ColumnLayoutBehavior.Id="CertSha256" Width="Auto" MinWidth="170" MaxWidth="560" ElementStyle="{StaticResource HashText}" />
            <DataGridTextColumn Header="{loc:Loc Column_CertAlgorithm}" Binding="{Binding CertificateAlgorithm}"
                                Visibility="{Binding Data.InspectCertificates, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" behaviors:ColumnLayoutBehavior.Id="CertAlgorithm" Width="Auto" MinWidth="140" MaxWidth="280" ElementStyle="{StaticResource GridText}" />
            <DataGridTextColumn Header="{loc:Loc Column_NativeCode}" Binding="{Binding NativeCode}"
                                Visibility="{Binding Data.InspectCertificates, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVisibility}}" behaviors:ColumnLayoutBehavior.Id="NativeCode" Width="Auto" MinWidth="120" MaxWidth="180" ElementStyle="{StaticResource HashText}" />
            <DataGridTextColumn Header="{loc:Loc Column_Diagnostic}" Binding="{Binding Diagnostic}" behaviors:ColumnLayoutBehavior.Id="Diagnostic" Width="Auto" MinWidth="220" MaxWidth="600" ElementStyle="{StaticResource GridText}" />
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}" Margin="30">
          <TextBlock Text="↓" FontSize="48" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
          <TextBlock Text="{loc:Loc DropTitle}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="{loc:Loc DropHint}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" TextAlignment="Center" />
          <TextBlock Text="{loc:Loc DropOptionsHint}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,7,0,0" TextAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{loc:Loc NoMatches}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"
                   Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False"
                   Visibility="{Binding ShowNoMatches, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </Border>

    <Expander Grid.Row="4" Header="{loc:Loc DetailsTitle}" Margin="24,0,24,12" IsExpanded="False">
      <TextBox Text="{Binding SelectedRow.Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" MinHeight="90" MaxHeight="160"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
               FontSize="12" Padding="12" Background="#FFFFFF" ToolTip="{loc:Loc DetailsHint}" AutomationProperties.Name="{loc:Loc DetailsTitle}" />
    </Expander>

    <Border Grid.Row="5" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
      <StackPanel>
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
          <TextBlock Grid.Column="1" Text="{Binding CurrentFile}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" ToolTip="{Binding CurrentFile}" />
        </Grid>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsCheckingSignature}" Height="4" Foreground="{StaticResource AccentBrush}" AutomationProperties.Name="{loc:Loc ProgressLabel}" />
        <TextBlock Text="{Binding LastError}" Foreground="#B42318" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
