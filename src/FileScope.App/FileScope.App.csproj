<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Resources\FileScope.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NeutralLanguage>en</NeutralLanguage>
    <Product>FileScope ($(TargetFramework))</Product>
    <Description>FileScope desktop file analysis.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF generates the early Show(true) call and the automatic fade-out. -->
    <None Remove="Resources\FileScopeSplash.png" />
    <SplashScreen Include="Resources\FileScopeSplash.png" />
    <ProjectReference Include="..\FileScope.Core\FileScope.Core.csproj" />
    <!-- One canonical license: available offline in the dialog and beside published binaries. -->
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="FileScope.App.LICENSE" />
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
