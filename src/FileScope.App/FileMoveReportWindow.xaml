<Window x:Class="FileScope.App.FileMoveReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FileScope.App.Localization"
        Title="{loc:Loc MoveReportTitle}" Width="960" Height="640" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindowStyle}">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBlock x:Name="MoveSummaryText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14" FontWeight="SemiBold" />
    <TextBox x:Name="MoveReportText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
             AutomationProperties.Name="{loc:Loc MoveReportTitle}" />
    <Button x:Name="CloseMoveReportButton" Grid.Row="2" Content="{loc:Loc Close}" IsDefault="True" IsCancel="True"
            Click="CloseReport" HorizontalAlignment="Right" Padding="18,7" Margin="0,14,0,0" />
  </Grid>
</Window>
