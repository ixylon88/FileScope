<Window x:Class="FileScope.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FileScope.App.Localization"
        Title="{loc:Loc AboutTitle}" Width="660" Height="720" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Style="{StaticResource AppWindowStyle}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Width="48" Height="48" Background="{DynamicResource SystemFillColorAttentionBrush}"
              CornerRadius="12" Margin="0,0,14,0" VerticalAlignment="Top">
        <TextBlock Text="FS" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextOnAccentFillColorSelectedTextBrush}" />
      </Border>
      <StackPanel Grid.Column="1">
        <TextBlock Text="FileScope" FontSize="26" FontWeight="SemiBold" />
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock Text="{loc:Loc AboutVersion}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,6,0" />
          <TextBlock x:Name="VersionValue" Grid.Column="1" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
        </Grid>
      </StackPanel>
    </Grid>
    <ScrollViewer x:Name="AboutScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
      <StackPanel>
        <TextBlock x:Name="AboutDescription" Text="{loc:Loc AboutDescription}" TextWrapping="Wrap" Margin="0,0,0,16" />
        <TextBlock Text="{loc:Loc AboutFeatures}" Style="{StaticResource GroupHeading}" />
        <StackPanel x:Name="FeatureList" Margin="0,0,0,16">
          <TextBlock TextWrapping="Wrap" Margin="0,0,0,7"><Run Text="• " /><Run Text="{loc:Loc AboutFeatureHashes}" /></TextBlock>
          <TextBlock TextWrapping="Wrap" Margin="0,0,0,7"><Run Text="• " /><Run Text="{loc:Loc AboutFeatureSignatures}" /></TextBlock>
          <TextBlock TextWrapping="Wrap" Margin="0,0,0,7"><Run Text="• " /><Run Text="{loc:Loc AboutFeatureMetadata}" /></TextBlock>
          <TextBlock TextWrapping="Wrap" Margin="0,0,0,7"><Run Text="• " /><Run Text="{loc:Loc AboutFeatureFiles}" /></TextBlock>
          <TextBlock TextWrapping="Wrap"><Run Text="• " /><Run Text="{loc:Loc AboutFeatureExport}" /></TextBlock>
        </StackPanel>
        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,18">
          <StackPanel>
            <TextBlock Text="{loc:Loc AboutEfficiencyTitle}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock x:Name="EfficiencyText" Text="{loc:Loc AboutEfficiency}" TextWrapping="Wrap" />
            <TextBlock x:Name="AdditionalReadsText" Text="{loc:Loc AboutAdditionalReads}" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
        <TextBlock Text="{loc:Loc AboutProject}" Style="{StaticResource GroupHeading}" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
          <Hyperlink x:Name="RepositoryLink" NavigateUri="https://github.com/ixylon88/FileScope" RequestNavigate="OpenProjectLink"
                     AutomationProperties.Name="{loc:Loc AboutRepository}">github.com/ixylon88/FileScope</Hyperlink>
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
          <Hyperlink x:Name="LicenseLink" NavigateUri="https://github.com/ixylon88/FileScope/blob/dev/LICENSE" RequestNavigate="OpenProjectLink"
                     AutomationProperties.Name="{loc:Loc AboutLicenseOnline}"><Run Text="{loc:Loc AboutLicenseOnline}" /></Hyperlink>
        </TextBlock>
        <TextBlock x:Name="LinkErrorText" Text="{loc:Loc AboutLinkError}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12" />
        <Expander x:Name="LicenseExpander" Header="{loc:Loc AboutLicenseText}">
          <TextBox x:Name="LicenseText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                   Height="200" Margin="0,10,0,0" Padding="10" FontSize="12"
                   AutomationProperties.Name="{loc:Loc AboutLicenseText}" />
        </Expander>
      </StackPanel>
    </ScrollViewer>
    <Button x:Name="CloseAboutButton" Grid.Row="2" Content="{loc:Loc Close}" IsDefault="True" IsCancel="True"
            Click="CloseAbout" HorizontalAlignment="Right" MinWidth="100" Padding="16,8" Margin="0,18,0,0" />
  </Grid>
</Window>
