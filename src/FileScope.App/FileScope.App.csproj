<Project Sdk="Microsoft.NET.Sdk">
  
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Resources\FileScope.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NeutralLanguage>en</NeutralLanguage>
    <Product>FileScope ($(TargetFramework))</Product>
    <Description>FileScope desktop file analysis.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="FileScope.Shared" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileScope.Core\FileScope.Core.csproj" />
    <ProjectReference Include="..\FileScope.Shared\FileScope.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF generates the early Show(true) call and the automatic fade-out. -->
    <None Remove="Resources\FileScopeSplash.png" />
    <SplashScreen Include="Resources\FileScopeSplash.png" />
    <Resource Include="Resources/FileScope.ico" />
    <!-- One canonical license: available offline in the dialog and beside published binaries. -->
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="FileScope.App.LICENSE" />
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  
  <ItemGroup Condition="'$(UseWPF)' == 'true'">
    <Page Include="../DesignTimeResources.xaml" Link="Properties/DesignTimeResources.xaml"
          Generator="MSBuild:Compile" SubType="Designer" ContainsDesignTimeResources="true" />
  </ItemGroup>
  
</Project>
