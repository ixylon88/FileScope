# FileScope | EditorConfig
# Erklärungen und Werte nebeneinander: docs/EDITORCONFIG.md
# Kommentare müssen eigene Zeilen haben; kein # oder ; hinter einem Wert.
# Regelstufen: none = aus, suggestion = Hinweis, warning = Warnung, error = Fehler.
# Einzelne dotnet_diagnostic-Regeln übersteuern die allgemeine Analyzer-Stufe.
# Die Datei steuert Stil/Diagnosen; Änderungen am Code entstehen erst durch Formatieren/Fixes.

# 01 | Vererbung
# Suche nach weiteren .editorconfig-Dateien oberhalb dieses Ordners beenden.
root = true

# 02 | Allgemeines Dateiformat
[*]
# Als UTF-8 ohne BOM speichern.
charset = utf-8
# Windows-Zeilenenden (CRLF) verwenden.
end_of_line = crlf
# Anzahl der Leerzeichen pro Einrückungsebene.
indent_size = 4
# Mit Leerzeichen statt Tabulatoren einrücken.
indent_style = space
# Abschließenden Zeilenumbruch beim Speichern ergänzen (true) bzw. nicht erzwingen (false).
insert_final_newline = true

# 03 | XAML, Projekte und Datenformate
[*.{xaml,csproj,props,resx,json}]
# Anzahl der Leerzeichen pro Einrückungsebene.
indent_size = 2

# 04 | C# / VB: Dateiformat
[*.{cs,vb}]
# Für C# / VB bleibt insert_final_newline = false als bewusste Ausnahme erhalten.
# Anzahl der Leerzeichen pro Einrückungsebene.
indent_size = 4
# Mit Leerzeichen statt Tabulatoren einrücken.
indent_style = space
# Abschließenden Zeilenumbruch beim Speichern ergänzen (true) bzw. nicht erzwingen (false).
insert_final_newline = false
# Leerzeichen am Zeilenende beim Speichern entfernen.
trim_trailing_whitespace = true

# 05 | C# / .NET: Schreibweise
# Gilt weiter für [*.{cs,vb}]. C#-spezifische Optionen werden bei VB ignoriert.
# IDE0007/IDE0008 sind unten ausgeschaltet: Die var-Präferenzen erzeugen daher keine entsprechenden Diagnosehinweise.
# Bei mehrzeiligen Anweisungen geschweifte Klammern verlangen.
csharp_prefer_braces = when_multiline:error
# default statt default(Typ) bevorzugen, wenn der Typ ableitbar ist.
csharp_prefer_simple_default_expression = true:suggestion
# Modifikatoren wie public/static/readonly in dieser Reihenfolge anordnen.
csharp_preferred_modifier_order = public, private, protected, internal, static, extern, new, virtual, abstract, sealed, override, readonly, unsafe, volatile, async:suggestion
# Für get/set => bevorzugen, wenn der Ausdruck einzeilig ist.
csharp_style_expression_bodied_accessors = when_on_single_line:suggestion
# Konstruktoren mit Blockkörper statt => bevorzugen.
csharp_style_expression_bodied_constructors = false:suggestion
# Für lokale Funktionen => bevorzugen, wenn der Ausdruck einzeilig ist.
csharp_style_expression_bodied_local_functions = when_on_single_line:suggestion
# Methoden mit Blockkörper statt => bevorzugen.
csharp_style_expression_bodied_methods = false:suggestion
# Für Eigenschaften => bevorzugen, wenn der Ausdruck einzeilig ist.
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
# Variablen direkt im out-Argument deklarieren.
csharp_style_inlined_variable_declaration = true:suggestion
# Typmuster statt as mit anschließendem null-Test bevorzugen.
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
# Lambda-Ausdrücke statt lokaler Funktionen bevorzugen (IDE0039).
csharp_style_prefer_local_over_anonymous_function = false:suggestion
# In den übrigen Fällen den Typ explizit ausschreiben.
csharp_style_var_elsewhere = false:suggestion
# Bei eingebauten Typen int/string usw. statt var bevorzugen.
csharp_style_var_for_built_in_types = false:suggestion
# var bevorzugen, wenn der Typ rechts bereits erkennbar ist.
csharp_style_var_when_type_is_apparent = true:suggestion
# Explizite Tupel-Elementnamen beim Zugriff nicht bevorzugen.
dotnet_style_explicit_tuple_names = false:suggestion
# Objektinitialisierer statt nachfolgender Zuweisungen bevorzugen.
dotnet_style_object_initializer = true:suggestion
# Bei Zeilenumbrüchen den Operator an den Anfang der Folgezeile setzen.
dotnet_style_operator_placement_when_wrapping = beginning_of_line
# Unnötige Klammern in arithmetischen Ausdrücken weglassen.
dotnet_style_parentheses_in_arithmetic_binary_operators = never_if_unnecessary:none
# Unnötige Klammern bei anderen binären Operatoren weglassen.
dotnet_style_parentheses_in_other_binary_operators = never_if_unnecessary:none
# Unnötige Klammern in Vergleichsausdrücken weglassen.
dotnet_style_parentheses_in_relational_binary_operators = never_if_unnecessary:none
# Sprachalias wie int/string bei Deklarationen bevorzugen.
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
# Sprachalias wie int.MaxValue statt Int32.MaxValue bevorzugen.
dotnet_style_predefined_type_for_member_access = true:suggestion
# Ableitbare Tupel-Elementnamen nicht erneut ausschreiben.
dotnet_style_prefer_inferred_tuple_names = true:suggestion
# Bei Ereigniszugriffen this./Me. weglassen.
dotnet_style_qualification_for_event = false:suggestion
# Bei Feldzugriffen this./Me. weglassen.
dotnet_style_qualification_for_field = false:suggestion
# Bei Methodenaufrufen this./Me. weglassen.
dotnet_style_qualification_for_method = false:suggestion
# Bei Eigenschaftszugriffen this./Me. weglassen.
dotnet_style_qualification_for_property = false:suggestion
# Sichtbarkeit explizit angeben, außer für Interface-Member.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion

# 06 | C#: Einrückung, Klammern und Abstände
# Anweisungen innerhalb eines case einrücken.
csharp_indent_case_contents = true
# Zusätzliche Einrückung des Blockkörpers eines case nicht vorsehen.
csharp_indent_case_contents_when_block = false
# Sprungmarken eine Ebene weniger als den umgebenden Code einrücken.
csharp_indent_labels = one_less_than_current
# case/default gegenüber switch einrücken.
csharp_indent_switch_labels = true
# else auf eine neue Zeile setzen.
csharp_new_line_before_else = true
# Zuweisungen in Objektinitialisierern auf getrennte Zeilen setzen.
csharp_new_line_before_members_in_object_initializers = true
# Öffnende Klammern für alle aufgeführten Konstrukte auf eine neue Zeile setzen.
csharp_new_line_before_open_brace = all
# Bereits einzeilige Blöcke beim Formatieren einzeilig lassen.
csharp_preserve_single_line_blocks = true
# Kein Leerzeichen zwischen Cast und Ausdruck: (int)value.
csharp_space_after_cast = false
# Leerzeichen nach dem Doppelpunkt einer Vererbungsliste setzen.
csharp_space_after_colon_in_inheritance_clause = true
# Leerzeichen nach if/for/while usw. setzen: if (…).
csharp_space_after_keywords_in_control_flow_statements = true
# Leerzeichen vor dem Doppelpunkt einer Vererbungsliste setzen.
csharp_space_before_colon_in_inheritance_clause = true
# Leere Argumentklammern von Aufrufen ohne Leerzeichen schreiben.
csharp_space_between_method_call_empty_parameter_list_parentheses = false
# Kein Leerzeichen zwischen Methodenname und Aufrufklammer.
csharp_space_between_method_call_name_and_opening_parenthesis = false
# Keine inneren Leerzeichen in Argumentklammern von Aufrufen.
csharp_space_between_method_call_parameter_list_parentheses = false
# Leere Parameterklammern von Deklarationen ohne Leerzeichen schreiben.
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
# Keine inneren Leerzeichen in Parameterklammern von Deklarationen.
csharp_space_between_method_declaration_parameter_list_parentheses = false
# System-using-Anweisungen vor die anderen using-Anweisungen sortieren.
dotnet_sort_system_directives_first = true

# 07 | Analyzer: Grundstufe
# Standardmäßig aktive Analyzer-Regeln als Fehler behandeln; Einzelregeln haben Vorrang.
dotnet_analyzer_diagnostic.severity = error

# 08 | .NET-Qualitätsregeln (CA)
# [HINWEIS] CA1002: Öffentliche List<T>-APIs vermeiden.
dotnet_diagnostic.CA1002.severity = suggestion
# [HINWEIS] CA1005: Zu viele generische Typparameter vermeiden.
dotnet_diagnostic.CA1005.severity = suggestion
# [AUS] CA1024: Geeignete Methoden durch Eigenschaften ersetzen.
dotnet_diagnostic.CA1024.severity = none
# [HINWEIS] CA1031: Pauschales Abfangen allgemeiner Exceptions vermeiden.
dotnet_diagnostic.CA1031.severity = suggestion
# [HINWEIS] CA1040: Leere Interfaces vermeiden.
dotnet_diagnostic.CA1040.severity = suggestion
# [AUS] CA1062: Argumente öffentlicher Methoden validieren.
dotnet_diagnostic.CA1062.severity = none
# [AUS] CA1303: Lokalisierbare Texte aus Ressourcen beziehen.
dotnet_diagnostic.CA1303.severity = none
# [HINWEIS] CA1305: Formatierung mit expliziter Kultur ausführen.
dotnet_diagnostic.CA1305.severity = suggestion
# [HINWEIS] CA1309: Ordinale Zeichenfolgenvergleiche bevorzugen.
dotnet_diagnostic.CA1309.severity = suggestion
# [HINWEIS] CA1501: Übermäßig tiefe Vererbung vermeiden.
dotnet_diagnostic.CA1501.severity = suggestion
# [HINWEIS] CA1502: Hohe zyklomatische Komplexität vermeiden.
dotnet_diagnostic.CA1502.severity = suggestion
# [HINWEIS] CA1505: Schlecht wartbaren Code erkennen.
dotnet_diagnostic.CA1505.severity = suggestion
# [HINWEIS] CA1506: Starke Kopplung zwischen Klassen vermeiden.
dotnet_diagnostic.CA1506.severity = suggestion
# [AUS] CA1508: Bedingungen mit konstantem Ergebnis erkennen.
dotnet_diagnostic.CA1508.severity = none
# [HINWEIS] CA1710: Vorgeschriebene Namenssuffixe verwenden.
dotnet_diagnostic.CA1710.severity = suggestion
# [HINWEIS] CA1716: Sprachschlüsselwörter als Bezeichner vermeiden.
dotnet_diagnostic.CA1716.severity = suggestion
# [HINWEIS] CA1724: Typ-/Namespace-Namenskonflikte vermeiden.
dotnet_diagnostic.CA1724.severity = suggestion
# [AUS] CA1727: Benannte Logging-Platzhalter in PascalCase schreiben.
dotnet_diagnostic.CA1727.severity = none
# [HINWEIS] CA1822: Instanzunabhängige Member static machen.
dotnet_diagnostic.CA1822.severity = suggestion
# [AUS] CA1848: Effizientes Logging über LoggerMessage verwenden.
dotnet_diagnostic.CA1848.severity = none
# [AUS] CA1852: Nicht abgeleitete interne Klassen versiegeln.
dotnet_diagnostic.CA1852.severity = none
# [AUS] CA1853: ContainsKey vor Dictionary.Remove vermeiden.
dotnet_diagnostic.CA1853.severity = none
# [AUS] CA1854: TryGetValue statt doppeltem Dictionary-Zugriff verwenden.
dotnet_diagnostic.CA1854.severity = none
# [HINWEIS] CA2000: Entsorgbare Objekte rechtzeitig freigeben.
dotnet_diagnostic.CA2000.severity = suggestion
# [HINWEIS] CA2002: Sperren auf öffentlich erreichbaren Objekten vermeiden.
dotnet_diagnostic.CA2002.severity = suggestion
# [HINWEIS] CA2100: Unsichere SQL-Befehlstexte erkennen.
dotnet_diagnostic.CA2100.severity = suggestion
# [AUS] CA2225: Benannte Alternativen für Operatorüberladungen anbieten.
dotnet_diagnostic.CA2225.severity = none
# [AUS] CA2254: Konstante Logging-Nachrichtenvorlagen verwenden.
dotnet_diagnostic.CA2254.severity = none
# [HINWEIS] CA2300: Unsicheren BinaryFormatter-Einsatz erkennen.
dotnet_diagnostic.CA2300.severity = suggestion
# [HINWEIS] CA2301: BinaryFormatter ohne sicheren Binder erkennen.
dotnet_diagnostic.CA2301.severity = suggestion
# [HINWEIS] CA5362: Referenzzyklen in deserialisierten Objektgraphen beachten.
dotnet_diagnostic.CA5362.severity = suggestion
# [HINWEIS] CA5392: DLL-Suchpfade für native Imports einschränken.
dotnet_diagnostic.CA5392.severity = suggestion

# 09 | IDE-Stilregeln und Compilerhinweise
# [HINWEIS] CS1591: Fehlende öffentliche XML-Dokumentation melden, wenn XML-Dokumentationsausgabe aktiv ist.
dotnet_diagnostic.CS1591.severity = suggestion
# [AUS] IDE0007: var statt explizitem Typ verwenden.
dotnet_diagnostic.IDE0007.severity = none
# [AUS] IDE0008: Expliziten Typ statt var verwenden.
dotnet_diagnostic.IDE0008.severity = none
# [HINWEIS] IDE0010: Fehlende switch-Fälle ergänzen.
dotnet_diagnostic.IDE0010.severity = suggestion
# [AUS] IDE0022: Methoden mit Ausdruckskörper vorschlagen.
dotnet_diagnostic.IDE0022.severity = none
# [HINWEIS] IDE0028: Collection-Initialisierer verwenden.
dotnet_diagnostic.IDE0028.severity = suggestion
# [AUS] IDE0031: Nullbedingte Zugriffe mit ?. verwenden.
dotnet_diagnostic.IDE0031.severity = none
# [AUS] IDE0045: Zuweisungen mit bedingtem Ausdruck vereinfachen.
dotnet_diagnostic.IDE0045.severity = none
# [AUS] IDE0046: return mit bedingtem Ausdruck vereinfachen.
dotnet_diagnostic.IDE0046.severity = none
# [AUS] IDE0050: Anonyme Typen in Tupel umwandeln.
dotnet_diagnostic.IDE0050.severity = none
# [WARNUNG] IDE0055: Die konfigurierten Formatierungsregeln prüfen.
dotnet_diagnostic.IDE0055.severity = warning
# [HINWEIS] IDE0057: Bereichsoperator (..) verwenden.
dotnet_diagnostic.IDE0057.severity = suggestion
# [AUS] IDE0058: Unbenutzte Ausdrucksergebnisse explizit behandeln.
dotnet_diagnostic.IDE0058.severity = none
# [AUS] IDE0070: System.HashCode für Hashcode-Berechnungen verwenden.
dotnet_diagnostic.IDE0070.severity = none
# [AUS] IDE0090: Zieltypisiertes new() verwenden.
dotnet_diagnostic.IDE0090.severity = none
# [AUS] IDE0130: Namespace an die Ordnerstruktur anpassen.
dotnet_diagnostic.IDE0130.severity = none
# [AUS] IDE0160: Namespace mit Blockklammern verwenden.
dotnet_diagnostic.IDE0160.severity = none
# [AUS] IDE0250: Geeignete Structs readonly machen.
dotnet_diagnostic.IDE0250.severity = none
# [AUS] IDE0270: null-Prüfungen vereinfachen.
dotnet_diagnostic.IDE0270.severity = none
# [HINWEIS] IDE0290: Primärkonstruktoren verwenden.
dotnet_diagnostic.IDE0290.severity = suggestion
# [HINWEIS] IDE0300: Collection-Ausdrücke für Arrays verwenden.
dotnet_diagnostic.IDE0300.severity = suggestion
# [HINWEIS] IDE0301: Collection-Ausdrücke für leere Collections verwenden.
dotnet_diagnostic.IDE0301.severity = suggestion
# [HINWEIS] IDE0305: Fluent-Aufrufketten durch Collection-Ausdrücke ersetzen.
dotnet_diagnostic.IDE0305.severity = suggestion

# 10 | StyleCop (optional)
# Nur wirksam mit StyleCop-Analyzern. Im Projekt ist kein solches Paket referenziert.
# Alle standardmäßig aktiven StyleCop-Dokumentationsregeln ausschalten.
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.DocumentationRules.severity = none
# [AUS] SA0001: Auf deaktivierte XML-Kommentaranalyse hinweisen.
dotnet_diagnostic.SA0001.severity = none
# [AUS] SA1010: Abstände an öffnenden eckigen Klammern prüfen.
dotnet_diagnostic.SA1010.severity = none
# [AUS] SA1101: Instanzzugriffe mit this. qualifizieren.
dotnet_diagnostic.SA1101.severity = none
# [HINWEIS] SA1124: #region-Blöcke vermeiden.
dotnet_diagnostic.SA1124.severity = suggestion
# [AUS] SA1200: Platzierung von using-Anweisungen prüfen.
dotnet_diagnostic.SA1200.severity = none
# [HINWEIS] SA1305: Ungarische Typpräfixe in Namen vermeiden.
dotnet_diagnostic.SA1305.severity = suggestion
# [AUS] SA1309: Feldnamen ohne führenden Unterstrich verlangen.
dotnet_diagnostic.SA1309.severity = none
# [HINWEIS] SA1404: Begründungen für Analyzer-Unterdrückungen verlangen.
dotnet_diagnostic.SA1404.severity = suggestion
# [AUS] SA1407: Operatorrangfolge in Rechenausdrücken durch Klammern verdeutlichen.
dotnet_diagnostic.SA1407.severity = none
# [AUS] SA1412: UTF-8 mit BOM verlangen.
dotnet_diagnostic.SA1412.severity = none
# [AUS] SA1413: Abschließende Kommas in mehrzeiligen Initialisierern verlangen.
dotnet_diagnostic.SA1413.severity = none
# [AUS] SA1500: Klammern mehrzeiliger Anweisungen auf eigene Zeilen setzen.
dotnet_diagnostic.SA1500.severity = none
# [AUS] SA1503: Geschweifte Klammern um Anweisungsblöcke verlangen.
dotnet_diagnostic.SA1503.severity = none
# [AUS] SA1504: Accessor-Körper einheitlich ein- oder mehrzeilig schreiben.
dotnet_diagnostic.SA1504.severity = none
# [AUS] SA1513: Leerzeile nach schließenden Blockklammern verlangen.
dotnet_diagnostic.SA1513.severity = none
# [AUS] SA1516: Deklarationen durch Leerzeilen trennen.
dotnet_diagnostic.SA1516.severity = none
# [FEHLER] SX1101: Instanzzugriffe ohne this. verlangen.
dotnet_diagnostic.SX1101.severity = error
# [FEHLER] SX1309: Private Instanzfelder mit Unterstrich beginnen lassen.
dotnet_diagnostic.SX1309.severity = error
# [FEHLER] SX1309S: Private veränderliche statische Felder mit Unterstrich beginnen lassen.
dotnet_diagnostic.SX1309S.severity = error

# 11 | Async-/Threading-Analyzer (optional)
# Nur wirksam mit AsyncFixer bzw. Microsoft.VisualStudio.Threading.Analyzers.
# [AUS] AsyncFixer01: Überflüssiges async/await erkennen.
dotnet_diagnostic.AsyncFixer01.severity = none
# [AUS] AsyncFixer02: Blockierende Aufrufe in async-Methoden erkennen.
dotnet_diagnostic.AsyncFixer02.severity = none
# [AUS] AsyncFixer03: async void-Methoden und -Delegaten erkennen.
dotnet_diagnostic.AsyncFixer03.severity = none
# [AUS] VSTHRD001: Veraltete Threadwechsel vermeiden.
dotnet_diagnostic.VSTHRD001.severity = none
# [AUS] VSTHRD002: Problematische synchrone Warteaufrufe vermeiden.
dotnet_diagnostic.VSTHRD002.severity = none
# [AUS] VSTHRD003: await auf fremd erzeugten Tasks prüfen.
dotnet_diagnostic.VSTHRD003.severity = none
# [AUS] VSTHRD103: In async-Methoden asynchrone APIs verwenden.
dotnet_diagnostic.VSTHRD103.severity = none
# [AUS] VSTHRD104: Asynchrone API-Alternative anbieten.
dotnet_diagnostic.VSTHRD104.severity = none
# [AUS] VSTHRD110: Ergebnisse asynchroner Aufrufe beobachten.
dotnet_diagnostic.VSTHRD110.severity = none

# 12 | Benennung: Regeln
# Verletzungen dieser Namensregel als Vorschlag anzeigen.
dotnet_naming_rule.interface_should_be_begins_with_i.severity = suggestion
# Für diese Namensregel den Stil "begins_with_i" verwenden.
dotnet_naming_rule.interface_should_be_begins_with_i.style = begins_with_i
# Diese Namensregel auf die Symbolgruppe "interface" anwenden.
dotnet_naming_rule.interface_should_be_begins_with_i.symbols = interface
# Verletzungen dieser Namensregel als Vorschlag anzeigen.
dotnet_naming_rule.non_field_members_should_be_pascal_case.severity = suggestion
# Für diese Namensregel den Stil "pascal_case" verwenden.
dotnet_naming_rule.non_field_members_should_be_pascal_case.style = pascal_case
# Diese Namensregel auf die Symbolgruppe "non_field_members" anwenden.
dotnet_naming_rule.non_field_members_should_be_pascal_case.symbols = non_field_members
# Verletzungen dieser Namensregel als Vorschlag anzeigen.
dotnet_naming_rule.types_should_be_pascal_case.severity = suggestion
# Für diese Namensregel den Stil "pascal_case" verwenden.
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case
# Diese Namensregel auf die Symbolgruppe "types" anwenden.
dotnet_naming_rule.types_should_be_pascal_case.symbols = types

# 13 | Benennung: Symbolgruppen
# Die Gruppe auf diese Sichtbarkeiten anwenden.
dotnet_naming_symbols.interface.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected
# Diese Symbolarten in die Gruppe aufnehmen.
dotnet_naming_symbols.interface.applicable_kinds = interface
# Keine zusätzlichen Modifikatoren wie static/readonly voraussetzen.
dotnet_naming_symbols.interface.required_modifiers =
# Die Gruppe auf diese Sichtbarkeiten anwenden.
dotnet_naming_symbols.non_field_members.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected
# Diese Symbolarten in die Gruppe aufnehmen.
dotnet_naming_symbols.non_field_members.applicable_kinds = property, event, method
# Keine zusätzlichen Modifikatoren wie static/readonly voraussetzen.
dotnet_naming_symbols.non_field_members.required_modifiers =
# Die Gruppe auf diese Sichtbarkeiten anwenden.
dotnet_naming_symbols.types.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected
# Diese Symbolarten in die Gruppe aufnehmen.
dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum
# Keine zusätzlichen Modifikatoren wie static/readonly voraussetzen.
dotnet_naming_symbols.types.required_modifiers =

# 14 | Benennung: Stile
# Jeden Wortbestandteil groß beginnen: PascalCase.
dotnet_naming_style.begins_with_i.capitalization = pascal_case
# Den Namenspräfix "I" verlangen.
dotnet_naming_style.begins_with_i.required_prefix = I
# Keinen Namenssuffix verlangen.
dotnet_naming_style.begins_with_i.required_suffix =
# Wortbestandteile ohne Trennzeichen verbinden.
dotnet_naming_style.begins_with_i.word_separator =
# Jeden Wortbestandteil groß beginnen: PascalCase.
dotnet_naming_style.pascal_case.capitalization = pascal_case
# Keinen Namenspräfix verlangen.
dotnet_naming_style.pascal_case.required_prefix =
# Keinen Namenssuffix verlangen.
dotnet_naming_style.pascal_case.required_suffix =
# Wortbestandteile ohne Trennzeichen verbinden.
dotnet_naming_style.pascal_case.word_separator =

# 15 | Ausnahmen für [**Test**.cs]
[**Test**.cs]
# Dieses Muster trifft Namen mit "Test"; CoreChecks.cs/UiChecks.cs verwenden stattdessen tests/.editorconfig.
# [AUS] CA1707: Unterstriche in Bezeichnern vermeiden.
dotnet_diagnostic.CA1707.severity = none
# [AUS] CA1822: Instanzunabhängige Member static machen.
dotnet_diagnostic.CA1822.severity = none
# [AUS] CA5394: Unsichere Zufallszahlengeneratoren erkennen.
dotnet_diagnostic.CA5394.severity = none
# [AUS] VSTHRD200: Asynchrone Methoden mit Async-Suffix benennen.
dotnet_diagnostic.VSTHRD200.severity = none

# 16 | Ausnahmen für [*.{tt.cs,feature.cs}]
[*.{tt.cs,feature.cs}]
# [AUS] IDE0005: Unnötige using-/Imports-Anweisungen entfernen.
dotnet_diagnostic.IDE0005.severity = none
# Dateien als generierten Code behandeln; viele Analyzer überspringen sie.
generated_code = true

# 17 | Ausnahmen für [*.csproj]
[*.csproj]
# Anzahl der Leerzeichen pro Einrückungsebene.
indent_size = 2
# Mit Leerzeichen statt Tabulatoren einrücken.
indent_style = space

# 18 | Ausnahmen für [*.wixproj]
[*.wixproj]
# Anzahl der Leerzeichen pro Einrückungsebene.
indent_size = 2
# Mit Leerzeichen statt Tabulatoren einrücken.
