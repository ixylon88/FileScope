<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- INFO: https://github.com/dotnet/wpf/blob/main/Documentation/docs/using-fluent.md -->
  
  <!-- Scale only the cross-axis: Fluent's 12-DIP bars occupy 24 DIPs,
       including the thumb and its hit area. Keep the native templates,
       colors, range, viewport and scrolling direction unchanged. -->
  <Style x:Key="ScrollBarStyle" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource {x:Type ScrollBar}}">
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Vertical">
        <Setter Property="LayoutTransform">
          <Setter.Value><ScaleTransform ScaleX="2" ScaleY="1" /></Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="LayoutTransform">
          <Setter.Value><ScaleTransform ScaleX="1" ScaleY="2" /></Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style BasedOn="{StaticResource ScrollBarStyle}" TargetType="{x:Type ScrollBar}" /> <!-- reference previously introduced key; intentionally, to prevent infinite ref loop for the case without key and without this line -->
  
  <!-- Fixes a list box item runtime error on theme change -->
  <Style x:Key="ListBoxItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style BasedOn="{StaticResource ListBoxItemStyle}" TargetType="{x:Type ListBoxItem}" />

  <Style x:Key="TabControlStyle" TargetType="{x:Type TabControl}" BasedOn="{StaticResource {x:Type TabControl}}">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style BasedOn="{StaticResource TabControlStyle}" TargetType="{x:Type TabControl}" />

  <Style x:Key="TabItemStyle" TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
    <Style.Resources>
      <!-- Fluent paints the selected header's inner border with this resource.
           Use the system color behind SystemFillColorAttentionBrush. -->
      <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected"
                       Color="{DynamicResource {x:Static SystemColors.AccentColorKey}}" />
    </Style.Resources>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Style.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsEnabled" Value="True" />
          <Condition Property="IsSelected" Value="False" />
          <Condition Property="IsMouseOver" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource DataGridHeaderBackgroundPointerOver}" />
      </MultiTrigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorSelectedTextBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style BasedOn="{StaticResource TabItemStyle}" TargetType="{x:Type TabItem}" />

  <Style x:Key="AppWindowStyle" TargetType="Window" BasedOn="{StaticResource {x:Type Window}}">
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="UseLayoutRounding" Value="True" />
  </Style>
  <Style x:Key="GroupHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="Margin" Value="0,0,0,5" />
  </Style>
  <Style x:Key="BandButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Margin" Value="0,0,8,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Style.Triggers>
      <!-- Glyph-and-label content must also look disabled in both Fluent palettes. -->
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="JobProgressBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
    <Setter Property="Visibility" Value="Hidden" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsBusy}" Value="True">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ResultsGridStyle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="CanUserDeleteRows" Value="False" />
    <Setter Property="SelectionMode" Value="Extended" />
    <Setter Property="SelectionUnit" Value="FullRow" />
    <Setter Property="ClipboardCopyMode" Value="IncludeHeader" />
  </Style>

  <Style x:Key="GridText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Margin" Value="9,7" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
  </Style>
  <Style x:Key="HashText" TargetType="TextBlock" BasedOn="{StaticResource GridText}">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style x:Key="NameText" TargetType="TextBlock" BasedOn="{StaticResource GridText}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="ShortcutKeyCap" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource LineBrush}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="MinHeight" Value="30" />
  </Style>
  <Style x:Key="ShortcutKeys" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="ShortcutDescription" TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="16,0,0,0" />
  </Style>
</ResourceDictionary>
